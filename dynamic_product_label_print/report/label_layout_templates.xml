<template id="report_dynamic_label">

    <t t-set="bcode"
       t-value="item_data.get('barcode') or product.barcode or product.default_code or str(product.id)"/>

    <t t-set="price_value"
       t-value="item_data.get('price') if item_data.get('price') is not None else product.list_price"/>

    <t t-set="english_name"
       t-value="item_data.get('product_name') or product.name or ''"/>

    <t t-set="arabic_name"
       t-value="product.arabic_name or ''"/>

    <t t-set="qr_data"
       t-value="'Product: %s | Arabic: %s | Price: %s QAR | Barcode: %s' % (english_name, arabic_name, ('%.2f' % float(price_value or 0.0)), bcode)"/>

    <!-- OUTER LABEL -->
    <div style="
        width:50mm;
        height:25mm;
        box-sizing:border-box;
        margin:0;
        padding:0.5mm;
        overflow:hidden;
        background:#FFFFFF;
        color:#111111;
        border:0.25mm solid #222222;
        font-family:'DejaVu Sans',sans-serif;
        text-align:center;
    ">

        <!-- ARABIC NAME -->
        <div style="
            width:100%;
            height:6mm;
            box-sizing:border-box;
            overflow:hidden;
            direction:rtl;
            text-align:center;
            font-size:7px;
            font-weight:bold;
            line-height:2.8mm;
            white-space:normal;
            word-wrap:break-word;
            overflow-wrap:break-word;
            padding:0 0.3mm;
            margin:0;
            color:#111111;
        ">
            <t t-out="arabic_name"/>
        </div>

        <!-- ENGLISH NAME -->
        <div style="
            width:100%;
            height:2.8mm;
            box-sizing:border-box;
            overflow:hidden;
            direction:ltr;
            text-align:center;
            font-size:6px;
            font-weight:bold;
            line-height:2.8mm;
            white-space:nowrap;
            padding:0 0.3mm;
            margin:0;
            color:#333333;
        ">
            <t t-out="english_name"/>
        </div>

        <!-- SEPARATOR -->
        <div style="
            width:98%;
            height:0.25mm;
            background:#444444;
            margin:0.2mm auto;
        "></div>

        <!-- BARCODE / QR / PRICE -->
        <table style="
            width:100%;
            height:14.5mm;
            table-layout:fixed;
            border-collapse:collapse;
            margin:0;
            padding:0;
        ">
            <tbody>
                <tr>

                    <!-- BARCODE -->
                    <td style="
                        width:43%;
                        padding:0;
                        vertical-align:middle;
                        text-align:center;
                    ">
                        <div t-if="bcode"
                             t-out="bcode"
                             style="margin:0 auto;"
                             t-options="{
                                'widget':'barcode',
                                'symbology':'Code128',
                                'quiet':1,
                                'img_style':'width:21mm;height:9mm;max-width:100%;'
                             }"/>

                        <div style="
                            font-size:5px;
                            font-weight:bold;
                            line-height:6px;
                            white-space:nowrap;
                            overflow:hidden;
                            margin-top:0.2mm;
                        ">
                            <t t-out="bcode"/>
                        </div>
                    </td>

                    <!-- QR CODE -->
                    <td style="
                        width:30%;
                        padding:0;
                        vertical-align:middle;
                        text-align:center;
                    ">
                        <div t-out="qr_data"
                             style="margin:0 auto;"
                             t-options="{
                                'widget':'barcode',
                                'symbology':'QR',
                                'quiet':1,
                                'img_style':'width:14mm;height:14mm;'
                             }"/>
                    </td>

                    <!-- PRICE -->
                    <td style="
                        width:27%;
                        padding:0;
                        vertical-align:middle;
                        text-align:center;
                        border-left:0.2mm solid #BBBBBB;
                    ">

                        <div style="
                            font-size:8px;
                            font-weight:bold;
                            line-height:9px;
                            color:#333333;
                        ">
                            ر.ق
                        </div>

                        <div style="
                            font-size:13px;
                            font-weight:bold;
                            line-height:15px;
                            color:#000000;
                            white-space:nowrap;
                            overflow:hidden;
                        ">
                            <t t-out="'%.2f' % float(price_value or 0.0)"/>
                        </div>

                        <div style="
                            font-size:7px;
                            font-weight:bold;
                            line-height:8px;
                            color:#333333;
                        ">
                            QAR
                        </div>

                    </td>

                </tr>
            </tbody>
        </table>

    </div>

</template>
