<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================= -->
    <!-- MAIN REPORT -->
    <!-- ================================================= -->
    <template id="report_dynamic">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-call="dynamic_product_label_print.report_productlabel_dynamic"/>
            </t>
        </t>
    </template>


    <!-- ================================================= -->
    <!-- PREMIUM THERMAL LABEL -->
    <!-- WIDTH: 50mm -->
    <!-- HEIGHT: 25mm -->
    <!-- ================================================= -->
    <template id="report_dynamic_label">

        <t t-set="bcode"
           t-value="item_data.get('barcode') or product.barcode or product.default_code or str(product.id)"/>

        <t t-set="price_value"
           t-value="item_data.get('price') if item_data.get('price') is not None else product.list_price"/>

        <t t-set="english_name"
           t-value="item_data.get('product_name') or product.name or ''"/>

        <t t-set="arabic_name"
           t-value="product.arabic_name or ''"/>

        <!-- QR CONTENT: PRODUCT INFORMATION -->
        <t t-set="qr_data"
           t-value="'Product: %s | Arabic: %s | Price: %s QAR | Barcode: %s' % (english_name, arabic_name, ('%.2f' % float(price_value or 0.0)), bcode)"/>


        <!-- OUTER LABEL -->
        <div style="
            width:50mm;
            height:25mm;
            box-sizing:border-box;
            margin:0;
            padding:0.5mm;
            overflow:hidden;
            background:#FFFFFF;
            color:#111111;
            border:0.35mm solid #333333;
            border-radius:1.2mm;
            font-family:'DejaVu Sans',sans-serif;
            text-align:center;
            page-break-inside:avoid;
        ">

            <!-- ========================================= -->
            <!-- ARABIC PRODUCT NAME -->
            <!-- AUTO WRAP - TWO LINES -->
            <!-- ========================================= -->
            <div style="
                width:100%;
                height:7.2mm;
                max-height:7.2mm;
                box-sizing:border-box;
                overflow:hidden;
                direction:rtl;
                text-align:center;
                font-family:'DejaVu Sans',sans-serif;
                font-size:9px;
                font-weight:bold;
                line-height:3.5mm;
                white-space:normal;
                word-wrap:break-word;
                overflow-wrap:break-word;
                padding:0 0.5mm;
                margin:0;
                color:#111111;
            ">
                <t t-out="arabic_name"/>
            </div>


            <!-- ========================================= -->
            <!-- ENGLISH PRODUCT NAME -->
            <!-- ========================================= -->
            <div style="
                width:100%;
                height:3mm;
                max-height:3mm;
                box-sizing:border-box;
                overflow:hidden;
                direction:ltr;
                text-align:center;
                font-size:6.5px;
                font-weight:bold;
                line-height:3mm;
                white-space:nowrap;
                padding:0 0.5mm;
                margin:0;
                color:#444444;
            ">
                <t t-out="english_name"/>
            </div>


            <!-- ========================================= -->
            <!-- SEPARATOR -->
            <!-- ========================================= -->
            <div style="
                width:96%;
                height:0.3mm;
                background:#555555;
                margin:0.3mm auto;
                font-size:0;
                line-height:0;
            "></div>


            <!-- ========================================= -->
            <!-- BARCODE / QR / PRICE -->
            <!-- ========================================= -->
            <table style="
                width:100%;
                height:13mm;
                table-layout:fixed;
                border-collapse:collapse;
                border-spacing:0;
                margin:0;
                padding:0;
            ">
                <tbody>
                    <tr>

                        <!-- BARCODE -->
                        <td style="
                            width:48%;
                            padding:0 0.3mm;
                            vertical-align:middle;
                            text-align:center;
                            border-right:0.2mm solid #CCCCCC;
                        ">

                            <div style="
                                width:100%;
                                height:12.5mm;
                                box-sizing:border-box;
                                overflow:hidden;
                                text-align:center;
                                padding:0;
                                margin:0;
                            ">

                                <div t-if="bcode"
                                     t-out="bcode"
                                     style="margin:0 auto;"
                                     t-options="{
                                        'widget':'barcode',
                                        'symbology':'Code128',
                                        'quiet':1,
                                        'img_style':'width:22mm;height:7.5mm;max-width:100%;'
                                     }"/>

                                <div style="
                                    font-size:5.5px;
                                    font-weight:bold;
                                    line-height:6px;
                                    color:#111111;
                                    white-space:nowrap;
                                    overflow:hidden;
                                    margin-top:0.2mm;
                                ">
                                    <t t-out="bcode"/>
                                </div>

                            </div>

                        </td>


                        <!-- QR CODE -->
                        <td style="
                            width:24%;
                            padding:0.2mm;
                            vertical-align:middle;
                            text-align:center;
                        ">

                            <div style="
                                width:100%;
                                height:12.5mm;
                                box-sizing:border-box;
                                text-align:center;
                                padding:0;
                                margin:0;
                            ">

                                <div t-out="qr_data"
                                     style="margin:0 auto;"
                                     t-options="{
                                        'widget':'barcode',
                                        'symbology':'QR',
                                        'quiet':1,
                                        'img_style':'width:11.5mm;height:11.5mm;'
                                     }"/>

                            </div>

                        </td>


                        <!-- PRICE -->
                        <td style="
                            width:28%;
                            padding:0 0.3mm;
                            vertical-align:middle;
                            text-align:center;
                            border-left:0.2mm solid #CCCCCC;
                        ">

                            <!-- CURRENCY -->
                            <div style="
                                color:#555555;
                                font-family:'DejaVu Sans',sans-serif;
                                font-size:7px;
                                font-weight:bold;
                                line-height:8px;
                                margin-bottom:0.5mm;
                            ">
                                ريال قطري
                            </div>

                            <!-- PRICE VALUE -->
                            <div style="
                                color:#000000;
                                font-family:'DejaVu Sans',sans-serif;
                                font-size:13px;
                                font-weight:bold;
                                line-height:15px;
                                white-space:nowrap;
                                overflow:hidden;
                            ">
                                <t t-out="'%.2f' % float(price_value or 0.0)"/>
                            </div>

                            <!-- QAR -->
                            <div style="
                                color:#444444;
                                font-family:'DejaVu Sans',sans-serif;
                                font-size:7px;
                                font-weight:bold;
                                line-height:8px;
                            ">
                                QAR
                            </div>

                        </td>

                    </tr>
                </tbody>
            </table>

        </div>

    </template>


    <!-- ================================================= -->
    <!-- LABEL COLLECTION -->
    <!-- ONE LABEL = ONE PAGE -->
    <!-- ================================================= -->
    <template id="report_productlabel_dynamic">

        <t t-set="labels" t-value="[]"/>

        <!-- COLLECT ALL LABELS -->
        <t t-foreach="quantity.items()"
           t-as="barcode_and_qty_by_product">

            <t t-set="product"
               t-value="barcode_and_qty_by_product[0]"/>

            <t t-foreach="barcode_and_qty_by_product[1]"
               t-as="item_data">

                <t t-foreach="range(int(item_data.get('qty', 1)))"
                   t-as="qty">

                    <t t-set="labels"
                       t-value="labels + [(product, item_data)]"/>

                </t>

            </t>

        </t>


        <!-- PRINT EVERY LABEL IN A SEPARATE PAGE -->
        <t t-foreach="labels" t-as="label">

            <div class="page"
                 t-att-style="
                    'width:50mm !important;'
                    'height:25mm !important;'
                    'min-height:25mm !important;'
                    'max-height:25mm !important;'
                    'margin:0 !important;'
                    'padding:0 !important;'
                    'box-sizing:border-box;'
                    'overflow:hidden;'
                    'page-break-inside:avoid;'
                    + ('page-break-after:always;' if label_index + 1 &lt; len(labels) else 'page-break-after:auto;')
                 ">

                <t t-set="product"
                   t-value="label[0]"/>

                <t t-set="item_data"
                   t-value="label[1]"/>

                <t t-call="dynamic_product_label_print.report_dynamic_label"/>

            </div>

        </t>

    </template>


    <!-- ================================================= -->
    <!-- THERMAL PAPER FORMAT -->
    <!-- 50mm x 25mm -->
    <!-- ================================================= -->
    <record id="paperformat_dynamic_a4_80x65"
            model="report.paperformat">

        <field name="name">Premium Thermal Label 50x25 mm</field>

        <field name="default" eval="False"/>

        <field name="format">custom</field>

        <field name="page_width">50</field>
        <field name="page_height">25</field>

        <field name="orientation">Portrait</field>

        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>

        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>

        <field name="dpi">90</field>

    </record>


    <!-- ================================================= -->
    <!-- REPORT ACTION -->
    <!-- ================================================= -->
    <record id="product_label_layout_form_dynamic"
            model="ir.actions.report">

        <field name="name">Premium Product Label 50x25</field>

        <field name="model">product.template</field>

        <field name="report_type">qweb-pdf</field>

        <field name="report_name">dynamic_product_label_print.report_dynamic</field>

        <field name="paperformat_id"
               ref="dynamic_product_label_print.paperformat_dynamic_a4_80x65"/>

        <field name="print_report_name">
            'Product Labels - %s' % (object.name)
        </field>

        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>

    </record>

</odoo>
