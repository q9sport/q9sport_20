<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================= -->
    <!-- MAIN REPORT -->
    <!-- ================================================= -->
    <template id="report_dynamic">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-call="dynamic_product_label_print.report_productlabel_dynamic"/>
            </t>
        </t>
    </template>


    <!-- ================================================= -->
    <!-- LABEL DESIGN: 50mm x 25mm -->
    <!-- ================================================= -->
    <template id="report_dynamic_label">

        <t t-set="bcode"
           t-value="item_data.get('barcode') or product.barcode or product.default_code or str(product.id)"/>

        <t t-set="price_value"
           t-value="item_data.get('price') if item_data.get('price') is not None else product.list_price"/>

        <t t-set="english_name"
           t-value="item_data.get('product_name') or product.name or ''"/>


        <!-- OUTER LABEL -->
        <div style="
            width:50mm;
            height:25mm;
            box-sizing:border-box;
            margin:0;
            padding:1.5mm 0.6mm 0.4mm 0.6mm;
            overflow:hidden;
            background:#FFFFFF;
            color:#000000;
            font-family:'DejaVu Sans',sans-serif;
            text-align:center;
        ">

            <!-- ARABIC NAME -->
            <div style="
                width:100%;
                height:3.8mm;
                overflow:hidden;
                direction:rtl;
                text-align:center;
                font-family:'DejaVu Sans',sans-serif;
                font-size:9px;
                font-weight:bold;
                line-height:3.8mm;
                white-space:nowrap;
                margin:0;
            ">
                <t t-out="item_data.get('arabic_name') or ''"/>
            </div>


            <!-- ENGLISH NAME -->
            <div style="
                width:100%;
                height:3.2mm;
                overflow:hidden;
                direction:ltr;
                text-align:center;
                font-size:7px;
                font-weight:bold;
                line-height:3.2mm;
                white-space:nowrap;
                margin:0;
            ">
                <t t-out="english_name"/>
            </div>


            <!-- SEPARATOR -->
            <div style="
                width:100%;
                height:0.25mm;
                background:#111111;
                margin:0.2mm 0;
            "></div>


            <!-- BARCODE / QR / PRICE -->
            <table style="
                width:100%;
                height:14.5mm;
                table-layout:fixed;
                border-collapse:collapse;
                border-spacing:0;
                margin:0;
                padding:0;
            ">
                <tbody>
                    <tr>

                        <!-- BARCODE -->
                        <td style="
                            width:48%;
                            padding:0.2mm;
                            vertical-align:middle;
                            text-align:center;
                        ">

                            <div t-if="bcode"
                                 t-out="bcode"
                                 style="margin:0 auto;"
                                 t-options="{
                                    'widget':'barcode',
                                    'symbology':'Code128',
                                    'quiet':1,
                                    'img_style':'width:22mm;height:8mm;max-width:100%;'
                                 }"/>

                            <div style="
                                font-size:6px;
                                font-weight:bold;
                                line-height:7px;
                                white-space:nowrap;
                                overflow:hidden;
                            ">
                                <t t-out="bcode"/>
                            </div>

                        </td>


                        <!-- REAL QR CODE IMAGE -->
                        <td style="
                            width:26%;
                            padding:0.2mm;
                            vertical-align:middle;
                            text-align:center;
                        ">

                            <img t-if="item_data.get('qr_url')"
                                 t-att-src="item_data.get('qr_url')"
                                 alt="Product QR Code"
                                 style="
                                    display:block;
                                    width:12mm;
                                    height:12mm;
                                    margin:0 auto;
                                    object-fit:contain;
                                 "/>

                        </td>


                        <!-- PRICE -->
                        <td style="
                            width:26%;
                            padding:0.2mm;
                            vertical-align:middle;
                            text-align:center;
                        ">

                            <div style="
                                font-size:7px;
                                font-weight:bold;
                                line-height:8px;
                            ">
                                PRICE
                            </div>

                            <div style="
                                font-size:12px;
                                font-weight:bold;
                                line-height:14px;
                                overflow:hidden;
                                white-space:nowrap;
                            ">
                                <t t-out="'%.2f' % float(price_value or 0.0)"/>
                                <span style="font-size:8px;"> ر.ق</span>
                            </div>

                        </td>

                    </tr>
                </tbody>
            </table>

        </div>

    </template>


    <!-- ================================================= -->
    <!-- LABEL COLLECTION -->
    <!-- ONE LABEL = ONE PAGE -->
    <!-- ================================================= -->
    <template id="report_productlabel_dynamic">

        <t t-set="labels" t-value="[]"/>

        <t t-foreach="quantity.items()"
           t-as="barcode_and_qty_by_product">

            <t t-set="product"
               t-value="barcode_and_qty_by_product[0]"/>

            <t t-foreach="barcode_and_qty_by_product[1]"
               t-as="item_data">

                <t t-foreach="range(int(item_data.get('qty', 1)))"
                   t-as="qty">

                    <t t-set="labels"
                       t-value="labels + [(product, item_data)]"/>

                </t>

            </t>

        </t>


        <!-- EACH LABEL IN SEPARATE PAGE -->
        <t t-foreach="labels" t-as="label">

            <div class="page" style="
                width:50mm !important;
                height:25mm !important;
                min-height:25mm !important;
                max-height:25mm !important;
                margin:0 !important;
                padding:0 !important;
                overflow:hidden;
                box-sizing:border-box;
                page-break-inside:avoid;
                page-break-after:always;
            ">

                <t t-set="product"
                   t-value="label[0]"/>

                <t t-set="item_data"
                   t-value="label[1]"/>

                <t t-call="dynamic_product_label_print.report_dynamic_label"/>

            </div>

        </t>

    </template>


    <!-- ================================================= -->
    <!-- THERMAL PAPER FORMAT: 50 x 25 MM -->
    <!-- ================================================= -->
    <record id="paperformat_dynamic_a4_80x65"
            model="report.paperformat">

        <field name="name">Thermal Label 50x25 mm</field>

        <field name="default" eval="False"/>

        <field name="format">custom</field>

        <field name="page_width">50</field>
        <field name="page_height">25</field>

        <field name="orientation">Portrait</field>

        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>

        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>

        <field name="dpi">90</field>

    </record>


    <!-- ================================================= -->
    <!-- REPORT ACTION -->
    <!-- ================================================= -->
    <record id="product_label_layout_form_dynamic"
            model="ir.actions.report">

        <field name="name">Product Label 50x25 Thermal</field>

        <field name="model">product.template</field>

        <field name="report_type">qweb-pdf</field>

        <field name="report_name">dynamic_product_label_print.report_dynamic</field>

        <field name="paperformat_id"
               ref="dynamic_product_label_print.paperformat_dynamic_a4_80x65"/>

        <field name="print_report_name">
            'Product Labels - %s' % (object.name)
        </field>

        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>

    </record>

</odoo>
