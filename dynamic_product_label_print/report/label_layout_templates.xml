<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================= -->
    <!-- MAIN REPORT -->
    <!-- ================================================= -->
    <template id="report_dynamic">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-call="dynamic_product_label_print.report_productlabel_dynamic"/>
            </t>
        </t>
    </template>


    <!-- ================================================= -->
    <!-- PRODUCT LABEL DESIGN -->
    <!-- SIZE: 50mm WIDTH x 25mm HEIGHT -->
    <!-- ================================================= -->
    <template id="report_dynamic_label">

        <t t-set="bcode"
           t-value="item_data.get('barcode') or product.barcode or product.default_code or str(product.id)"/>

        <t t-set="price_value"
           t-value="item_data.get('price') if item_data.get('price') is not None else product.list_price"/>

        <t t-set="english_name"
           t-value="item_data.get('product_name') or product.name or ''"/>

        <!-- OUTER LABEL -->
        <div style="
            width:50mm;
            height:25mm;
            max-width:50mm;
            max-height:25mm;
            box-sizing:border-box;
            margin:0;
            padding:0.6mm;
            overflow:hidden;
            background-color:#FFFFFF;
            color:#111111;
            border:0.3mm solid #111111;
            font-family:'DejaVu Sans',sans-serif;
            text-align:center;
            page-break-inside:avoid;
            -webkit-print-color-adjust:exact;
            print-color-adjust:exact;
        ">

            <!-- ARABIC NAME -->
            <div style="
                width:100%;
                height:4mm;
                max-height:4mm;
                box-sizing:border-box;
                overflow:hidden;
                direction:rtl;
                text-align:center;
                color:#111111;
                font-family:'DejaVu Sans',sans-serif;
                font-size:11px;
                font-weight:bold;
                line-height:4mm;
                white-space:nowrap;
                padding:0;
                margin:0;
            ">
                <t t-out="product.arabic_name or ''"/>
            </div>

            <!-- ENGLISH NAME -->
            <div style="
                width:100%;
                height:3mm;
                max-height:3mm;
                box-sizing:border-box;
                overflow:hidden;
                direction:ltr;
                text-align:center;
                color:#111111;
                font-family:'DejaVu Sans',sans-serif;
                font-size:7px;
                font-weight:bold;
                line-height:3mm;
                white-space:nowrap;
                padding:0;
                margin:0;
            ">
                <t t-out="english_name"/>
            </div>

            <!-- SEPARATOR -->
            <div style="
                height:0.25mm;
                width:96%;
                background-color:#111111;
                margin:0.3mm auto;
                font-size:0;
                line-height:0;
            "></div>

            <!-- BARCODE / QR / PRICE -->
            <table style="
                width:100%;
                height:15mm;
                max-height:15mm;
                table-layout:fixed;
                border-collapse:collapse;
                border-spacing:0;
                margin:0;
                padding:0;
            ">
                <tbody>
                    <tr>

                        <!-- BARCODE -->
                        <td style="
                            width:48%;
                            padding:0 0.3mm;
                            vertical-align:middle;
                            text-align:center;
                        ">

                            <div style="
                                width:100%;
                                height:14mm;
                                box-sizing:border-box;
                                overflow:hidden;
                                background-color:#FFFFFF;
                                text-align:center;
                                padding:0;
                                margin:0;
                            ">

                                <div t-if="bcode"
                                     t-out="bcode"
                                     style="margin:0 auto;"
                                     t-options="{
                                        'widget':'barcode',
                                        'symbology':'Code128',
                                        'quiet':1,
                                        'img_style':'width:22mm;height:8mm;max-width:100%;'
                                     }"/>

                                <div style="
                                    width:100%;
                                    color:#111111;
                                    font-family:'DejaVu Sans',sans-serif;
                                    font-size:6px;
                                    font-weight:bold;
                                    line-height:7px;
                                    margin-top:0.3mm;
                                    white-space:nowrap;
                                    overflow:hidden;
                                ">
                                    <t t-out="bcode"/>
                                </div>

                            </div>

                        </td>

                        <!-- QR CODE -->
                        <td style="
                            width:26%;
                            padding:0 0.2mm;
                            vertical-align:middle;
                            text-align:center;
                        ">

                            <div style="
                                width:100%;
                                height:14mm;
                                box-sizing:border-box;
                                background-color:#FFFFFF;
                                text-align:center;
                                padding:0;
                                margin:0;
                            ">

                                <div t-if="bcode"
                                     t-out="bcode"
                                     style="margin:0 auto;"
                                     t-options="{
                                        'widget':'barcode',
                                        'symbology':'QR',
                                        'quiet':1,
                                        'img_style':'width:12mm;height:12mm;'
                                     }"/>

                            </div>

                        </td>

                        <!-- PRICE -->
                        <td style="
                            width:26%;
                            padding:0 0.2mm;
                            vertical-align:middle;
                            text-align:center;
                        ">

                            <div style="
                                color:#333333;
                                font-family:'DejaVu Sans',sans-serif;
                                font-size:7px;
                                font-weight:bold;
                                line-height:8px;
                            ">
                                PRICE
                            </div>

                            <div style="
                                color:#000000;
                                font-family:'DejaVu Sans',sans-serif;
                                font-size:12px;
                                font-weight:bold;
                                line-height:14px;
                                overflow:hidden;
                            ">
                                <t t-out="'%.2f' % float(price_value or 0.0)"/>
                            </div>

                        </td>

                    </tr>
                </tbody>
            </table>

        </div>

    </template>


    <!-- ================================================= -->
    <!-- LABEL COLLECTION -->
    <!-- ONE LABEL PER PAGE -->
    <!-- ================================================= -->
    <template id="report_productlabel_dynamic">

        <!-- BUILD LABEL LIST -->
        <t t-set="labels" t-value="[]"/>

        <t t-foreach="quantity.items()"
           t-as="barcode_and_qty_by_product">

            <t t-set="product"
               t-value="barcode_and_qty_by_product[0]"/>

            <t t-foreach="barcode_and_qty_by_product[1]"
               t-as="item_data">

                <t t-foreach="range(int(item_data.get('qty', 1)))"
                   t-as="qty">

                    <t t-set="labels"
                       t-value="labels + [(product, item_data)]"/>

                </t>

            </t>

        </t>


        <!-- EACH LABEL IN ITS OWN PAGE -->
        <t t-foreach="labels" t-as="label">

            <div class="page" style="
                width:50mm !important;
                height:25mm !important;
                min-height:25mm !important;
                max-height:25mm !important;
                margin:0 !important;
                padding:0 !important;
                box-sizing:border-box;
                overflow:hidden;
                page-break-inside:avoid;
                page-break-after:always;
                break-after:page;
            ">

                <t t-set="product"
                   t-value="label[0]"/>

                <t t-set="item_data"
                   t-value="label[1]"/>

                <t t-call="dynamic_product_label_print.report_dynamic_label"/>

            </div>

        </t>

    </template>


    <!-- ================================================= -->
    <!-- THERMAL PAPER FORMAT -->
    <!-- WIDTH = 50 MM -->
    <!-- HEIGHT = 25 MM -->
    <!-- ================================================= -->
    <record id="paperformat_dynamic_a4_80x65"
            model="report.paperformat">

        <field name="name">Thermal Label 50x25 mm</field>

        <field name="default" eval="False"/>

        <field name="format">custom</field>

        <field name="page_width">50</field>
        <field name="page_height">25</field>

        <field name="orientation">Portrait</field>

        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>

        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>

        <field name="dpi">90</field>

    </record>


    <!-- ================================================= -->
    <!-- REPORT ACTION -->
    <!-- ================================================= -->
    <record id="product_label_layout_form_dynamic"
            model="ir.actions.report">

        <field name="name">Product Label 50x25 Thermal</field>

        <field name="model">product.template</field>

        <field name="report_type">qweb-pdf</field>

        <field name="report_name">dynamic_product_label_print.report_dynamic</field>

        <field name="paperformat_id"
               ref="dynamic_product_label_print.paperformat_dynamic_a4_80x65"/>

        <field name="print_report_name">
            'Product Labels - %s' % (object.name)
        </field>

        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>

    </record>

</odoo>
