<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_purchase_order_barcode_wizard_form"
            model="ir.ui.view">

        <field name="name">purchase.order.barcode.wizard.form</field>
        <field name="model">purchase.order.barcode.wizard</field>

        <field name="arch" type="xml">

            <form string="Select Products for Barcode Printing">

                <group>
                    <field name="purchase_order_id" readonly="1"/>
                </group>

                <group string="Barcode Settings">

                    <field name="barcode_type"/>
                    <field name="label_format"/>

                </group>

                <separator string="Select Products and Labels Quantity"/>

                <field name="line_ids">

                    <list editable="bottom"
                          decoration-success="selected"
                          decoration-danger="not selected">

                        <field name="selected"/>

                        <field name="product_id" readonly="1"/>

                        <field name="barcode" readonly="1"/>

                        <field name="quantity"
                               string="Labels Quantity"/>

                        <field name="price_unit" readonly="1"/>

                    </list>

                </field>

                <footer>

                    <button name="action_print_barcodes"
                            type="object"
                            string="Print Selected"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>

                </footer>

            </form>

        </field>
    </record>

</odoo>
