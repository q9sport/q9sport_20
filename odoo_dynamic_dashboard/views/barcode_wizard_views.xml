<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Original Purchase Order barcode wizard view: kept intact. -->
    <record id="view_purchase_order_barcode_wizard_form" model="ir.ui.view">
        <field name="name">purchase.order.barcode.wizard.form</field>
        <field name="model">purchase.order.barcode.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Products for Barcode Printing">
                <group invisible="not purchase_order_id">
                    <field name="purchase_order_id" readonly="1"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom"
                          decoration-success="selected"
                          decoration-danger="not selected">
                        <field name="selected"/>
                        <field name="product_id" readonly="1"/>
                        <field name="barcode" readonly="1"/>
                        <field name="quantity" string="Labels Quantity"
                               decoration-success="quantity &gt; 0"
                               decoration-danger="quantity &lt;= 0"/>
                    </list>
                </field>
                <separator string="Label Printing"/>
                <group col="2">
                    <group string="Label Layout">
                        <field name="label_format" widget="radio"
                               options="{'horizontal': true}"/>
                    </group>
                    <group string="Barcode Type">
                        <field name="barcode_type" widget="radio"
                               options="{'horizontal': true}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_selected" type="object"
                            icon="fa-print" string="Print Selected"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Dedicated Products-list form. No blank-line creation; quantities stay editable.
         delete="1" shows the row trash icon so a product can be removed. -->
    <record id="view_product_barcode_wizard_form" model="ir.ui.view">
        <field name="name">purchase.order.barcode.wizard.product.list.form</field>
        <field name="model">purchase.order.barcode.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Product Barcodes">
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="1"
                          decoration-success="selected"
                          decoration-danger="not selected">
                        <field name="selected" string="Print"/>
                        <field name="product_id" readonly="1"/>
                        <field name="barcode" readonly="1"/>
                        <field name="display_currency_id" column_invisible="True"/>
                        <field name="display_price" widget="monetary" readonly="1"/>
                        <field name="quantity" string="Labels Quantity"
                               decoration-success="quantity &gt; 0"
                               decoration-danger="quantity &lt;= 0"/>
                    </list>
                </field>
                <separator string="Label Printing"/>
                <group col="2">
                    <group string="Label Layout">
                        <field name="label_format" widget="radio"
                               options="{'horizontal': true}"/>
                    </group>
                    <group string="Barcode Type">
                        <field name="barcode_type" widget="radio"
                               options="{'horizontal': true}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_selected" type="object"
                            icon="fa-print" string="Print Selected"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Button appears in the Product Templates list selection toolbar. -->
    <record id="view_product_template_list_barcode_button" model="ir.ui.view">
        <field name="name">product.template.list.barcode.button</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[1]" position="before">
                <header>
                    <button name="action_open_product_barcode_wizard"
                            type="object"
                            string="Print Barcodes"
                            icon="fa-barcode"
                            class="btn-primary"/>
                </header>
            </xpath>
        </field>
    </record>

</odoo>
