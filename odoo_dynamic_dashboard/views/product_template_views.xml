<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Dynamic Field Wizard -->
    <record id="view_product_dynamic_field_wizard_form"
            model="ir.ui.view">

        <field name="name">product.dynamic.field.wizard.form</field>
        <field name="model">product.dynamic.field.wizard</field>
        <field name="arch" type="xml">

            <form string="Add Product Field">

                <group>
                    <field name="field_label"
                           placeholder="Enter Field Label"
                           required="1"/>

                    <field name="field_name"
                           placeholder="x_color"
                           required="1"/>
                </group>

                <footer>

                    <button name="action_create_field"
                            type="object"
                            string="Create Field"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>

                </footer>

            </form>

        </field>
    </record>


    <!-- Add Button to Product Template -->
    <record id="product_template_form_add_dynamic_char_button"
            model="ir.ui.view">

        <field name="name">
            product.template.form.add.dynamic.char.button
        </field>

        <field name="model">product.template</field>

        <field name="inherit_id"
               ref="product.product_template_only_form_view"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='season']" position="after">

                <button name="action_open_dynamic_char_field_wizard"
                        type="object"
                        string="+ (Add Attribute)"
                        class="btn btn-primary"
                        groups="base.group_system"/>

            </xpath>

        </field>

    </record>

</odoo>
