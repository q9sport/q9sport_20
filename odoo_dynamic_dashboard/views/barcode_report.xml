<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Paper Format -->
    <record id="paperformat_purchase_order_barcodes" model="report.paperformat">
        <field name="name">Q9SPORT Product Labels A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- Report Action -->
    <record id="action_purchase_order_barcodes" model="ir.actions.report">
        <field name="name">Purchase Order Product Labels</field>
        <field name="model">purchase.order.barcode.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odoo_dynamic_dashboard.purchase_order_barcode_template</field>
        <field name="paperformat_id" ref="odoo_dynamic_dashboard.paperformat_purchase_order_barcodes"/>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>
    </record>

    <!-- QWeb Template -->
    <template id="purchase_order_barcode_template">
        <t t-call="web.html_container">

            <style type="text/css">

                @font-face {
                    font-family: 'Q9Arabic';
                    src: url('/odoo_dynamic_dashboard/static/src/fonts/NotoNaskhArabic-Regular.ttf') format('truetype');
                    font-weight: normal;
                    font-style: normal;
                }

                * {
                    box-sizing: border-box;
                }

                .page {
                    margin: 0 !important;
                    padding: 0 !important;
                }

                .labels-table {
                    width: 100%;
                    border-collapse: separate;
                    border-spacing: 2mm 2mm;
                    table-layout: fixed;
                }

                .labels-table td {
                    padding: 0;
                    vertical-align: top;
                }

                /* Main Label */
                .purchase-label {
                    width: 100%;
                    height: 46mm;
                    overflow: hidden;
                    background: #ffffff;
                    border: 1px solid #000000;
                    border-radius: 1mm;
                    color: #000000;
                    text-align: center;
                    padding: 2mm;
                    page-break-inside: avoid;
                }

                .purchase-label-inner {
                    width: 100%;
                    height: 100%;
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    justify-content: space-around;
                    overflow: hidden;
                }

                /* Arabic Name */
                .purchase-label-arabic {
                    width: 100%;
                    min-height: 5mm;
                    max-height: 9mm;
                    overflow: hidden;
                    direction: rtl;
                    text-align: center;
                    font-family: 'Q9Arabic', sans-serif;
                    font-size: 12px;
                    line-height: 1.2;
                    color: #000000;
                    font-weight: bold;
                    word-wrap: break-word;
                }

                /* English Name */
                .purchase-label-english {
                    width: 100%;
                    max-height: 8mm;
                    overflow: hidden;
                    text-align: center;
                    direction: ltr;
                    font-family: Arial, sans-serif;
                    font-size: 9px;
                    line-height: 1.2;
                    color: #000000;
                    font-weight: bold;
                    word-wrap: break-word;
                }

                /* Price */
                .purchase-label-price {
                    width: 100%;
                    color: #000000;
                    font-family: Arial, sans-serif;
                    font-size: 12px;
                    font-weight: bold;
                    text-align: center;
                    white-space: nowrap;
                    direction: ltr;
                    line-height: 1.2;
                }

                .purchase-label-currency {
                    display: inline-block;
                    margin-left: 1mm;
                    font-size: 10px;
                    font-weight: normal;
                    direction: ltr;
                }

                /* Code128 */
                .purchase-label-barcode {
                    display: block;
                    width: 95%;
                    height: 12mm;
                    object-fit: contain;
                    margin: 0 auto;
                }

                .purchase-label-barcode-text {
                    color: #000000;
                    font-family: Arial, sans-serif;
                    font-size: 8px;
                    line-height: 1;
                    text-align: center;
                    direction: ltr;
                }

                /* QR */
                .purchase-label-qr {
                    display: block;
                    width: 18mm;
                    height: 18mm;
                    object-fit: contain;
                    margin: 0 auto;
                    background: #ffffff;
                }

                /* Dynamic: 3 x 3 */
                .format-dynamic .purchase-label {
                    height: 46mm;
                }

                .format-dynamic .labels-table td {
                    width: 33.333%;
                }

                /* Dymo */
                .format-dymo .purchase-label {
                    height: 35mm;
                }

                .format-dymo .labels-table td {
                    width: 100%;
                }

                .format-dymo .purchase-label-arabic {
                    font-size: 11px;
                }

                .format-dymo .purchase-label-english {
                    font-size: 8px;
                }

                .format-dymo .purchase-label-qr {
                    width: 13mm;
                    height: 13mm;
                }

                .format-dymo .purchase-label-barcode {
                    height: 9mm;
                }

                /* 2 x 7 */
                .format-2x7 .purchase-label {
                    height: 38mm;
                }

                .format-2x7 .labels-table td {
                    width: 50%;
                }

                .format-2x7 .purchase-label-arabic {
                    font-size: 10px;
                }

                .format-2x7 .purchase-label-english {
                    font-size: 8px;
                }

                .format-2x7 .purchase-label-qr {
                    width: 14mm;
                    height: 14mm;
                }

                .format-2x7 .purchase-label-barcode {
                    height: 10mm;
                }

                /* 4 x 7 */
                .format-4x7 .purchase-label {
                    height: 31mm;
                    padding: 1mm;
                }

                .format-4x7 .labels-table td {
                    width: 25%;
                }

                .format-4x7 .purchase-label-arabic {
                    font-size: 8px;
                    min-height: 3mm;
                    max-height: 5mm;
                }

                .format-4x7 .purchase-label-english {
                    font-size: 7px;
                    max-height: 5mm;
                }

                .format-4x7 .purchase-label-price {
                    font-size: 9px;
                }

                .format-4x7 .purchase-label-currency {
                    font-size: 7px;
                }

                .format-4x7 .purchase-label-qr {
                    width: 11mm;
                    height: 11mm;
                }

                .format-4x7 .purchase-label-barcode {
                    height: 8mm;
                }

                .format-4x7 .purchase-label-barcode-text {
                    font-size: 6px;
                }

                /* 4 x 12 */
                .format-4x12 .purchase-label {
                    height: 21mm;
                    padding: 1mm;
                }

                .format-4x12 .purchase-label-inner {
                    justify-content: center;
                    gap: 0.5mm;
                }

                .format-4x12 .purchase-label-arabic {
                    font-size: 7px;
                    min-height: 2mm;
                    max-height: 4mm;
                }

                .format-4x12 .purchase-label-english {
                    font-size: 6px;
                    max-height: 4mm;
                }

                .format-4x12 .purchase-label-price {
                    font-size: 8px;
                }

                .format-4x12 .purchase-label-currency {
                    font-size: 6px;
                }

                .format-4x12 .purchase-label-qr {
                    width: 9mm;
                    height: 9mm;
                }

                .format-4x12 .purchase-label-barcode {
                    height: 6mm;
                }

                .format-4x12 .purchase-label-barcode-text {
                    font-size: 5px;
                }

            </style>

            <t t-foreach="report_data" t-as="item">

                <t t-set="wizard" t-value="item['wizard']"/>

                <t t-foreach="item['pages']" t-as="page_rows">

                    <div t-att-class="'page format-' + wizard.label_format">

                        <table class="labels-table">
                            <tbody>

                                <tr t-foreach="page_rows" t-as="row">

                                    <td t-foreach="row" t-as="label">

                                        <div class="purchase-label">

                                            <div class="purchase-label-inner">

                                                <!-- Arabic Product Name -->
                                                <div class="purchase-label-arabic">
                                                    <span t-esc="label['arabic_name'] or ''"/>
                                                </div>

                                                <!-- English Product Name -->
                                                <div class="purchase-label-english">
                                                    <span t-esc="label['english_name'] or ''"/>
                                                </div>

                                                <!-- Product Price -->
                                                <div class="purchase-label-price">
                                                    <span t-out="'%.2f' % (label['price'] or 0.0)"/>
                                                    <span class="purchase-label-currency"
                                                          t-esc="label['currency'].symbol if label['currency'] else ''"/>
                                                </div>

                                                <!-- QR Code -->
                                                <t t-if="label['barcode_type'] == 'qr'">
                                                    <img class="purchase-label-qr"
                                                         t-att-src="'data:image/png;base64,' + label['barcode_base64']"
                                                         alt="QR Code"/>
                                                </t>

                                                <!-- Code128 Barcode -->
                                                <t t-else="">
                                                    <img class="purchase-label-barcode"
                                                         t-att-src="'data:image/png;base64,' + label['barcode_base64']"
                                                         alt="Barcode"/>

                                                    <div class="purchase-label-barcode-text">
                                                        <span t-esc="label['barcode']"/>
                                                    </div>
                                                </t>

                                            </div>

                                        </div>

                                    </td>

                                </tr>

                            </tbody>
                        </table>

                    </div>

                </t>

            </t>

        </t>
    </template>

</odoo>
