<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="account_reports.AccountReportFiltersCustomizable"
       t-inherit-mode="extension">
        <xpath expr="//div[@id='filter_analytic_groupby']" position="after">
            <t t-if="this.controller.cachedFilterOptions().display_account_selection">
                <div id="filter_account_selection">
                    <t t-call="kbi_custom.AccountReportFilterAccountSelection"/>
                </div>
            </t>
        </xpath>
    </t>
</templates>
