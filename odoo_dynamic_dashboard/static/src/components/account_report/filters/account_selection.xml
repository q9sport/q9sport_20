<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="kbi_custom.AccountReportFilterAccountSelection">
        <Dropdown menuClass="'account_report_filter account_selection'">
            <button class="btn btn-secondary">
                <i class="fa fa-list me-1"/>Accounts
            </button>
            <t t-set-slot="content">
                <div class="dropdown-item">
                    <MultiRecordSelector
                        t-props="this.getMultiRecordSelectorProps(
                            'account.account',
                            'account_selection_ids'
                        )"
                    />
                </div>
            </t>
        </Dropdown>
    </t>
</templates>
