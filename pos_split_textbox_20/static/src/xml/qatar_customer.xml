<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_split_textbox_20.PaymentScreenQatarCustomer"
       t-inherit="point_of_sale.PaymentScreenDue"
       t-inherit-mode="extension">

        <xpath expr="//section[hasclass('paymentlines-container')]"
               position="after">

            <section class="o_qatar_inline_customer">

                <div class="o_qatar_inline_header">
                    <div class="o_qatar_inline_title">
                        <span class="o_qatar_inline_icon">
                            <i class="fa fa-user" aria-hidden="true"/>
                        </span>
                        <div>
                            <strong>
                                Customer &amp; Delivery Information
                                <span class="o_qatar_en_subtitle">
                                    Customer &amp; Delivery
                                </span>
                            </strong>
                            <small>
                                Enter the phone number first to automatically load customer details.
                            </small>
                        </div>
                    </div>
                    <span class="o_qatar_required_hint">* Required</span>
                </div>

                <div class="o_qatar_inline_grid">

                    <label class="o_qatar_field">
                        <span>
                            <i class="fa fa-phone"/>
                            Phone <b>*</b>
                        </span>
                        <input type="tel"
                               autocomplete="tel"
                               placeholder="+974 XXXXXXXX"
                               t-att-value="this.getQatarCustomerValue('phone')"
                               t-on-input="(ev) => this.onQatarCustomerInput('phone', ev)"
                               t-on-blur="() => this.lookupQatarCustomerByPhone()"
                               t-on-keydown="(ev) => this.onQatarPhoneKeydown(ev)"/>
                    </label>

                    <label class="o_qatar_field">
                        <span>
                            <i class="fa fa-user"/>
                            Customer Name <b>*</b>
                        </span>
                        <input type="text"
                               autocomplete="name"
                               placeholder="Customer Name"
                               t-att-value="this.getQatarCustomerValue('name')"
                               t-on-input="(ev) => this.onQatarCustomerInput('name', ev)"/>
                    </label>

           

                    <label class="o_qatar_field">
                        <span>
                            <i class="fa fa-calendar"/>
                            Date of Birth
                        </span>
                        <input type="date"
                               autocomplete="bday"
                               t-att-value="this.getQatarCustomerValue('birthdate_date')"
                               t-on-input="(ev) => this.onQatarCustomerInput('birthdate_date', ev)"/>
                    </label>

                    <label class="o_qatar_field">
                        <span>
                            <i class="fa fa-map"/>
                            Zone No <b>*</b>
                        </span>
                        <input type="text"
                               inputmode="numeric"
                               placeholder="Zone No"
                               t-att-value="this.getQatarCustomerValue('zone_no')"
                               t-on-input="(ev) => this.onQatarCustomerInput('zone_no', ev)"/>
                    </label>

                    <label class="o_qatar_field">
                        <span>
                            <i class="fa fa-road"/>
                            Street No <b>*</b>
                        </span>
                        <input type="text"
                               inputmode="numeric"
                               placeholder="Street No"
                               t-att-value="this.getQatarCustomerValue('street_no')"
                               t-on-input="(ev) => this.onQatarCustomerInput('street_no', ev)"/>
                    </label>
                            <label class="o_qatar_field">
                        <span>
                            <i class="fa fa-building"/>
                            Building No <b>*</b>
                        </span>
                        <input type="text"
                               inputmode="numeric"
                               placeholder="Building No"
                               t-att-value="this.getQatarCustomerValue('building_no')"
                               t-on-input="(ev) => this.onQatarCustomerInput('building_no', ev)"/>
                    </label>

   

                </div>

                <div class="o_qatar_inline_gps">

                    <div class="o_qatar_inline_gps_text">
                        <strong>
                            <i class="fa fa-map-marker"/>
                            GPS Location
                        </strong>

                        <small class="o_qatar_arabic_location"
                               t-if="this.getQatarCustomerValue('location_description_ar')">
                            <t t-out="this.getQatarCustomerValue('location_description_ar')"/>
                        </small>

                        <small t-elif="this.getQatarCustomerValue('gps_latitude') and this.getQatarCustomerValue('gps_longitude')">
                            <t t-out="this.getQatarCustomerValue('gps_latitude')"/>,
                            <t t-out="this.getQatarCustomerValue('gps_longitude')"/>
                        </small>

                        <small t-else="">
                            Enter the address details to identify the exact building location.
                        </small>
                    </div>

                    <div class="o_qatar_location_actions">

                        <button type="button"
                                class="o_qatar_inline_gps_button o_qatar_resolve_address_button"
                                t-on-click="() => this.resolveQatarAddress()"
                                t-att-disabled="this.qatarCustomer.resolvingAddress">

                            <i class="fa fa-location-arrow"/>

                            <t t-if="this.qatarCustomer.resolvingAddress">
                                Searching for building...
                            </t>

                            <t t-else="">
                                Verify Address &amp; Locate Building
                            </t>

                        </button>

                        <a t-attf-class="o_qatar_inline_map_button {{ (!this.getQatarCustomerValue('gps_latitude') || !this.getQatarCustomerValue('gps_longitude')) ? 'o_qatar_map_disabled' : '' }}"
                           t-att-href="this.getQatarMapSearchUrl()"
                           t-att-aria-disabled="!this.getQatarCustomerValue('gps_latitude') || !this.getQatarCustomerValue('gps_longitude')"
                           target="_blank"
                           rel="noopener noreferrer">

                            <i class="fa fa-map"/>
                            View Exact Location on Map

                        </a>

                    </div>
                </div>
                         
                             <label class="o_qatar_field o_qatar_address_field">
                        <span>
                            <i class="fa fa-map-marker"/>
                            Address
                        </span>
                        <input type="text"
                               autocomplete="street-address"
                               placeholder="Enter Address"
                               dir="auto"
                             
                               t-att-value="this.getQatarCustomerValue('street')"
                               t-on-input="(ev) => this.onQatarCustomerInput('street', ev)"/>
                    </label>

                <button type="button"
                        class="o_qatar_inline_save"
                        t-on-click="() => this.onClickSaveQatarCustomer()"
                        t-att-disabled="this.qatarCustomer.saving">

                    <i class="fa fa-check-circle"/>

                    <t t-if="this.qatarCustomer.saving">
                        Saving...
                    </t>

                    <t t-else="">
                        Save Customer Information
                    </t>

                </button>

            </section>

        </xpath>
    </t>

</templates>
