<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pos_ui_designer.Chrome" t-inherit="point_of_sale.Chrome" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-content')]" position="attributes"><attribute name="t-att-class">{'pui-layout-host': this.puiEnabled}</attribute></xpath>
    </t>
    <t t-name="pos_ui_designer.ProductScreen" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-screen')]" position="attributes">
            <attribute name="class" remove="d-flex" separator=" "/>
            <attribute name="t-att-class">{'d-flex': !this.puiEnabled, 'pui-scope pui-grid': this.puiEnabled, 'pui-vertical': this.puiEnabled and this.puiDesign.action_direction === 'vertical'}</attribute>
            <attribute name="t-att-style">this.puiStyle</attribute>
            <attribute name="t-att-data-keypad-position">this.puiEnabled and this.puiDesign.sales_keypad_position</attribute>
        </xpath>
        <xpath expr="//div[hasclass('leftpane')]" position="attributes">
            <attribute name="class" remove="d-flex" separator=" "/>
            <attribute name="t-att-class">{'pui-contents': this.puiEnabled, 'd-flex': !this.puiEnabled, 'flex-grow-1 w-100 mw-100': !this.puiEnabled and this.pos.isSmallProductScreen, 'flex-shrink-0': !this.pos.isSmallProductScreen, 'd-none': !this.puiEnabled and this.pos.isSmallProductScreen and this.pos.mobile_pane !== 'left'}</attribute>
        </xpath>
        <xpath expr="//OrderSummary" position="before">
            <div class="pui-pass pui-order" t-att-class="{'pui-slot': this.puiEnabled}" t-att-style="this.puiRegion('order')"/>
        </xpath>
        <xpath expr="//div[hasclass('pui-order')]" position="inside"><xpath expr="//OrderSummary" position="move"/></xpath>
        <xpath expr="//div[hasclass('pads')]" position="attributes"><attribute name="t-att-class">{'pui-contents': this.puiEnabled}</attribute></xpath>
        <xpath expr="//div[hasclass('subpads')]" position="attributes">
            <attribute name="class" remove="d-flex" separator=" "/>
            <attribute name="t-att-class">{'pui-contents': this.puiEnabled, 'd-flex': !this.puiEnabled}</attribute>
        </xpath>
        <xpath expr="//div[hasclass('control-buttons')]" position="attributes">
            <attribute name="class" remove="gap-2" separator=" "/>
            <attribute name="t-att-class">{'pui-slot pui-actions': this.puiEnabled, 'gap-2': !this.puiEnabled}</attribute>
            <attribute name="t-att-style">this.puiRegion('actions')</attribute>
        </xpath>
        <xpath expr="//ControlButtons" position="attributes"><attribute name="t-if">this.puiEnabled or !this.pos.isSmallProductScreen</attribute></xpath>
        <xpath expr="//Numpad" position="before"><div class="pui-pass pui-keypad" t-att-class="{'pui-slot': this.puiEnabled}" t-att-style="this.puiRegion('keypad')"/></xpath>
        <xpath expr="//div[hasclass('pui-keypad')]" position="inside"><xpath expr="//Numpad" position="move"/></xpath>
        <xpath expr="//ActionpadWidget" position="before"><div class="pui-pass pui-checkout" t-att-class="{'pui-slot': this.puiEnabled}" t-att-style="this.puiRegion('checkout')"/></xpath>
        <xpath expr="//div[hasclass('pui-checkout')]" position="inside"><xpath expr="//ActionpadWidget" position="move"/></xpath>
        <xpath expr="//div[hasclass('rightpane')]" position="attributes">
            <attribute name="t-if">this.puiEnabled or !this.pos.isSmallProductScreen or this.pos.mobile_pane === 'right'</attribute>
            <attribute name="t-att-class">{'pui-slot pui-products': this.puiEnabled, 'bg-secondary': !this.puiEnabled}</attribute>
            <attribute name="t-att-style">this.puiRegion('products')</attribute>
            <attribute name="class" remove="bg-secondary" separator=" "/>
        </xpath>
        <xpath expr="//ProductCard" position="attributes"><attribute name="imageUrl">(!this.puiEnabled or !this.puiDesign.text_only) and this.pos.config.show_product_images and this.getProductImage(product)</attribute></xpath>
        <xpath expr="//t[@t-if='this.pos.isSmallProductScreen']" position="attributes"><attribute name="t-if">this.pos.isSmallProductScreen and !this.puiEnabled</attribute></xpath>
    </t>

    <t t-name="pos_ui_designer.PaymentScreen" t-inherit="point_of_sale.PaymentScreen" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='this.ui.isSmall']" position="attributes"><attribute name="t-if">this.ui.isSmall and !this.puiEnabled</attribute></xpath>
        <xpath expr="//t[@t-else]/div[hasclass('payment-screen')]" position="attributes">
            <attribute name="class" remove="d-flex" separator=" "/>
            <attribute name="t-att-class">{'d-flex': !this.puiEnabled, 'pui-scope': this.puiEnabled, 'pui-sticky': this.puiEnabled and this.puiDesign.sticky_payment}</attribute>
            <attribute name="t-att-style">this.puiStyle</attribute>
            <attribute name="t-att-data-keypad-position">this.puiEnabled and this.puiDesign.payment_keypad_position</attribute>
            <attribute name="t-att-data-methods-position">this.puiEnabled and this.puiDesign.payment_methods_position</attribute>
        </xpath>
        <xpath expr="//div[hasclass('main-content')]" position="attributes">
            <attribute name="class" remove="d-flex bg-100 gap-2" separator=" "/>
            <attribute name="t-att-class">{'pui-grid': this.puiEnabled, 'd-flex bg-100 gap-2': !this.puiEnabled}</attribute>
        </xpath>
        <xpath expr="//div[hasclass('left-content')]" position="attributes">
            <attribute name="class" remove="d-flex" separator=" "/>
            <attribute name="t-att-class">{'pui-contents': this.puiEnabled, 'd-flex': !this.puiEnabled}</attribute>
        </xpath>
        <xpath expr="//div[hasclass('left-content')]/div[1]" position="attributes">
            <attribute name="t-att-class">{'pui-slot pui-methods': this.puiEnabled}</attribute>
            <attribute name="t-att-style">this.puiRegion('methods')</attribute>
        </xpath>
        <xpath expr="//div[hasclass('left-content')]/div[2]" position="attributes"><attribute name="t-att-class">{'pui-contents': this.puiEnabled}</attribute></xpath>
        <xpath expr="//Numpad" position="before"><div class="pui-pass pui-keypad" t-att-class="{'pui-slot': this.puiEnabled}" t-att-style="this.puiRegion('keypad')"/></xpath>
        <xpath expr="//div[hasclass('pui-keypad')]" position="inside"><xpath expr="//Numpad" position="move"/></xpath>
        <xpath expr="//div[hasclass('left-content')]/div[3]" position="attributes">
            <attribute name="t-att-class">{'pui-slot pui-checkout payment-footer': this.puiEnabled}</attribute>
            <attribute name="t-att-style">this.puiRegion('checkout')</attribute>
        </xpath>
        <xpath expr="//div[hasclass('center-content')]" position="attributes">
            <attribute name="t-att-class">{'pui-slot pui-summary': this.puiEnabled}</attribute>
            <attribute name="t-attf-class">{{ !this.puiEnabled and !this.paymentLines.length ? 'justify-content-center align-items-center' : '' }}</attribute>
            <attribute name="t-att-style">this.puiRegion('summary')</attribute>
        </xpath>
    </t>
    <t t-name="pos_ui_designer.PaymentButtons" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-buttons')]" position="attributes">
            <attribute name="t-att-class">{'pui-slot pui-options': this.puiEnabled}</attribute>
            <attribute name="t-att-style">this.puiRegion('options')</attribute>
        </xpath>
    </t>
    <t t-name="pos_ui_designer.PaymentDue" t-inherit="point_of_sale.PaymentScreenDue" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('total')]" position="attributes">
            <attribute name="class" remove="text-dark" separator=" "/>
            <attribute name="t-att-class">{'text-dark': !this.puiEnabled}</attribute>
            <attribute name="t-att-style">this.puiEnabled ? 'font-size:clamp(28px, 5vw, 72px)' : (!this.ui.isSmall ? 'font-size:125px' : '')</attribute>
        </xpath>
    </t>
    <t t-name="pos_ui_designer.PaymentMethodImages" t-inherit="point_of_sale.PaymentScreenMethods" t-inherit-mode="extension">
        <xpath expr="//img[hasclass('payment-method-icon')]" position="attributes"><attribute name="t-if">!this.puiEnabled</attribute></xpath>
        <xpath expr="//div[hasclass('paymentmethods')]" position="attributes">
            <attribute name="class" remove="gap-1 gap-lg-2" separator=" "/>
            <attribute name="t-att-class">{'gap-1 gap-lg-2': !this.puiEnabled, 'd-grid p-1 overflow-y-auto rounded-3 bg-200': this.ui.isSmall, 'd-flex': !this.ui.isSmall, 'flex-column': !this.ui.isSmall and (!this.puiEnabled or !['top', 'bottom'].includes(this.puiDesign.payment_methods_position))}</attribute>
        </xpath>
    </t>

    <t t-name="pos_ui_designer.OptionalActions" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//InternalNoteButton" position="before"><div class="pui-pass pui-action-item pui-action-0" t-if="this.puiActionVisible('internal_note')" t-att-style="this.puiActionStyle('internal_note')"/></xpath>
        <xpath expr="//div[hasclass('pui-action-0')]" position="inside"><xpath expr="//InternalNoteButton" position="move"/></xpath>
        <xpath expr="//button[contains(@t-if, 'pos.config.use_presets')]" position="before"><div class="pui-pass pui-action-item pui-action-2" t-if="this.puiActionVisible('preset')" t-att-style="this.puiActionStyle('preset')"/></xpath>
        <xpath expr="//div[hasclass('pui-action-2')]" position="inside"><xpath expr="//button[contains(@t-if, 'pos.config.use_presets')]" position="move"/></xpath>
        <xpath expr="//NoteButton" position="before"><div class="pui-pass pui-action-item pui-action-3" t-if="this.puiActionVisible('customer_note')" t-att-style="this.puiActionStyle('customer_note')"/></xpath>
        <xpath expr="//div[hasclass('pui-action-3')]" position="inside"><xpath expr="//NoteButton" position="move"/></xpath>
        <xpath expr="//t[@t-call='point_of_sale.controlButton'][@name='o_pricelist_button']" position="before"><div class="pui-pass pui-action-item pui-action-5" t-if="this.puiActionVisible('pricelist')" t-att-style="this.puiActionStyle('pricelist')"/></xpath>
        <xpath expr="//div[hasclass('pui-action-5')]" position="inside"><xpath expr="//t[@t-call='point_of_sale.controlButton'][@name='o_pricelist_button']" position="move"/></xpath>
        <xpath expr="//t[@t-call='point_of_sale.controlButton'][contains(@t-if, 'fiscal_position')]" position="before"><div class="pui-pass pui-action-item pui-action-6" t-if="this.puiActionVisible('tax')" t-att-style="this.puiActionStyle('tax')"/></xpath>
        <xpath expr="//div[hasclass('pui-action-6')]" position="inside"><xpath expr="//t[@t-call='point_of_sale.controlButton'][contains(@t-if, 'fiscal_position')]" position="move"/></xpath>
        <xpath expr="//t[@t-call='point_of_sale.controlButton'][@t-if='this.displayProductInfoBtn()']" position="before"><div class="pui-pass pui-action-item pui-action-7" t-if="this.puiActionVisible('info')" t-att-style="this.puiActionStyle('info')"/></xpath>
        <xpath expr="//div[hasclass('pui-action-7')]" position="inside"><xpath expr="//t[@t-call='point_of_sale.controlButton'][@t-if='this.displayProductInfoBtn()']" position="move"/></xpath>
        <xpath expr="//div[hasclass('control-buttons-modal')]" position="attributes"><attribute name="t-att-class">{'pui-scope': this.puiEnabled}</attribute><attribute name="t-att-style">this.puiTheme</attribute></xpath>
    </t>
</templates>
