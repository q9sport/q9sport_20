<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pui_pos_config_form" model="ir.ui.view">
        <field name="name">pos.config.form.ui.designer</field><field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside"><page string="UI Designer" name="pui_designer" groups="point_of_sale.group_pos_manager">
                <field name="company_id" invisible="1"/>
                <group><field name="pui_enabled"/><field name="pui_profile_id" invisible="not pui_enabled" required="pui_enabled" domain="[('company_id', '=', company_id)]" options="{'no_quick_create': True}"/></group>
                <p>Save and apply on the next safe POS load. Active orders are never automatically refreshed. Disable UI Designer to restore standard layouts. Duplicate a shared profile before making an independent design.</p>
            </page></xpath>
        </field>
    </record>
    <record id="pui_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.ui.designer</field><field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <setting string="UI Designer" help="Configure sales/payment layouts using a reusable CSS design profile. Changes apply on the next POS load." groups="point_of_sale.group_pos_manager">
                    <field name="pos_pui_enabled"/>
                    <div class="content-group" invisible="not pos_pui_enabled"><field name="pos_pui_profile_id" required="pos_pui_enabled" options="{'no_quick_create': True}"/></div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
