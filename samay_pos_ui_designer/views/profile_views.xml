<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pui_profile_list" model="ir.ui.view">
        <field name="name">pos.ui.designer.profile.list</field><field name="model">pos.ui.designer.profile</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="preset"/><field name="appearance"/><field name="company_id" groups="base.group_multi_company"/><field name="active"/></list></field>
    </record>
    <record id="pui_profile_search" model="ir.ui.view">
        <field name="name">pos.ui.designer.profile.search</field><field name="model">pos.ui.designer.profile</field>
        <field name="arch" type="xml"><search><field name="name"/><field name="company_id"/><filter name="archived" string="Archived" domain="[('active', '=', False)]"/></search></field>
    </record>
    <record id="pui_profile_form" model="ir.ui.view">
        <field name="name">pos.ui.designer.profile.form</field><field name="model">pos.ui.designer.profile</field>
        <field name="arch" type="xml">
            <form string="POS UI Designer">
                <header>
                    <button name="action_duplicate" type="object" string="Duplicate Profile" class="btn-secondary"/>
                    <button name="action_reset_defaults" type="object" string="Reset Design" confirm="Reset this profile's layout, colors, and optional actions? All assigned POS will receive the default design on their next load."/>
                </header>
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <div class="alert alert-info" role="status">Shared profile: saved changes affect every assigned POS on its next load. Duplicate this profile for an independent design. No active order is reloaded.</div>
                    <notebook>
                        <page string="General" name="general">
                            <group><group><field name="company_id" options="{'no_create': True}"/><field name="active"/><field name="density"/><field name="text_only"/></group>
                            <group><field name="config_ids" readonly="1"><list create="0" delete="0"><field name="name"/><field name="pui_enabled"/></list></field><div class="text-muted" colspan="2">Assign this profile in each POS configuration's UI Designer tab, or in POS Settings → PoS Interface → UI Designer.</div></group></group>
                        </page>
                        <page string="Sales Screen" name="sales">
                            <group>
                                <group string="Panel Positions"><field name="sales_keypad_position"/><field name="sales_actions_position"/><field name="sales_first_panel"/><field name="cart_side"/><field name="cart_width"/><field name="action_direction"/></group>
                                <group string="Size and Density"><field name="button_height"/><field name="keypad_height"/><field name="spacing"/><field name="keypad_spacing"/><field name="product_min_width"/><field name="product_font_size"/></group>
                            </group>
                            <div class="alert alert-light" role="status">Left/right panels flank the central cart and catalog. Top/bottom panels span their full width. Panels sharing a position stack in the selected order. Below 1101px panels stack vertically; checkout stays last.</div>
                            <separator string="Optional Actions"/>
                            <p>Visibility never grants permissions. Checkout, Back, More, customer selection, and cancellation remain accessible. Buttons supplied by other addons keep their existing behavior.</p>
                            <field name="action_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="code"/><field name="visible"/></list></field>
                        </page>
                        <page string="Payment Screen" name="payment">
                            <group><group string="Panel Positions"><field name="payment_keypad_position"/><field name="payment_methods_position"/><field name="payment_first_panel"/><field name="payment_summary_position"/><field name="sticky_payment"/></group>
                            <group string="Appearance"><field name="payment_inherit"/><field name="payment_primary_color" widget="pui_color" invisible="payment_inherit"/><field name="payment_accent_color" widget="pui_color" invisible="payment_inherit"/></group></group>
                            <p>Summary Left/Right sets its side within the central payment area. Top/Bottom makes it a full-width panel. Button sizes, density, surfaces, and typography are shared with Sales; payment accents can be independent. Validate and Back always remain available. Existing terminal cancellation controls stay with their payment lines.</p>
                        </page>
                        <page string="Colors and Appearance" name="appearance">
                            <group><group string="Theme"><field name="preset"/><field name="appearance"/><field name="primary_color" widget="pui_color"/><field name="accent_color" widget="pui_color"/><field name="background_color" widget="pui_color"/><field name="surface_color" widget="pui_color"/><field name="text_color" widget="pui_color"/></group>
                            <group string="Status and Shape"><field name="success_color" widget="pui_color"/><field name="warning_color" widget="pui_color"/><field name="danger_color" widget="pui_color"/><field name="font_size"/><field name="radius"/><field name="shadow"/></group></group>
                            <p>Changing the preset replaces primary/accent colors. Changing Light/Dark replaces background/surface/text colors. Save validates #RRGGBB colors, bounded sizes, and 4.5:1 text contrast.</p>
                        </page>
                        <page string="Preview" name="preview"><widget name="pos_ui_designer_preview"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="pui_profile_action" model="ir.actions.act_window"><field name="name">POS UI Designer</field><field name="res_model">pos.ui.designer.profile</field><field name="view_mode">list,form</field><field name="help" type="html"><p>Create a CSS design profile, then assign it to a POS configuration.</p></field></record>
    <menuitem id="pui_designer_menu" name="POS UI Designer" parent="point_of_sale.menu_point_config_product" action="pui_profile_action" sequence="15" groups="point_of_sale.group_pos_manager"/>
</odoo>
