<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Extend the native Sales Details PDF; do not create another wizard/report/menu. -->
    <template id="q9_extend_native_sales_details" inherit_id="point_of_sale.report_saledetails">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <t t-if="docs and docs._name == 'pos.details.wizard'">
                <t t-set="q9_extra" t-value="docs[:1]._q9_get_sales_details_extra()"/>
                <div class="mt-4" style="page-break-before: always;">
                    <h2>Q9 Daily Cashier Details</h2>
                    <h3>Daily Cash Collections</h3>
                    <table class="table table-sm">
                        <thead><tr><th>Payment Method</th><th class="text-end">Transactions</th><th class="text-end">Amount</th></tr></thead>
                        <tbody>
                            <tr t-foreach="q9_extra['payments']" t-as="payment">
                                <td t-esc="payment[0]"/><td class="text-end" t-esc="payment[1]"/>
                                <td class="text-end"><span t-esc="payment[2]" t-options="{'widget': 'monetary', 'display_currency': q9_extra['currency']}"/></td>
                            </tr>
                            <tr class="fw-bold"><td>NET COLLECTIONS</td><td class="text-end"/><td class="text-end"><span t-esc="q9_extra['cash_total'] + q9_extra['card_total'] + q9_extra['credit_total']" t-options="{'widget': 'monetary', 'display_currency': q9_extra['currency']}"/></td></tr>
                        </tbody>
                    </table>
                    <h3>Credit Accounts Report</h3>
                    <table class="table table-sm">
                        <thead><tr><th>Account Code</th><th>Customer</th><th class="text-end">Orders</th><th class="text-end">Credit Amount</th></tr></thead>
                        <tbody><tr t-foreach="q9_extra['credit_accounts']" t-as="account"><td t-esc="account['code']"/><td t-esc="account['name']"/><td class="text-end" t-esc="account['count']"/><td class="text-end"><span t-esc="account['amount']" t-options="{'widget': 'monetary', 'display_currency': q9_extra['currency']}"/></td></tr></tbody>
                    </table>
                    <h3>Daily Items Report</h3>
                    <table class="table table-sm">
                        <thead><tr><th>Item Code</th><th>Item</th><th class="text-end">Qty Sold</th><th class="text-end">Total</th></tr></thead>
                        <tbody><tr t-foreach="q9_extra['products']" t-as="product"><td t-esc="product['code']"/><td t-esc="product['name']"/><td class="text-end" t-esc="product['qty']"/><td class="text-end"><span t-esc="product['amount']" t-options="{'widget': 'monetary', 'display_currency': q9_extra['currency']}"/></td></tr></tbody>
                    </table>
                    <h3>Daily Return Report</h3>
                    <table class="table table-sm">
                        <thead><tr><th>Item Code</th><th>Item</th><th class="text-end">Qty Returned</th><th class="text-end">Refund</th></tr></thead>
                        <tbody><tr t-foreach="q9_extra['returns']" t-as="product"><td t-esc="product['code']"/><td t-esc="product['name']"/><td class="text-end" t-esc="product['returned_qty']"/><td class="text-end"><span t-esc="product['refund']" t-options="{'widget': 'monetary', 'display_currency': q9_extra['currency']}"/></td></tr></tbody>
                    </table>
                    <h3>Cashier Performance</h3>
                    <table class="table table-sm">
                        <thead><tr><th>Cashier</th><th class="text-end">Orders</th><th class="text-end">Sales</th><th class="text-end">Average Sale</th></tr></thead>
                        <tbody><tr t-foreach="q9_extra['cashiers']" t-as="cashier"><td t-esc="cashier['name']"/><td class="text-end" t-esc="cashier['count']"/><td class="text-end"><span t-esc="cashier['total']" t-options="{'widget': 'monetary', 'display_currency': q9_extra['currency']}"/></td><td class="text-end"><span t-esc="cashier['average']" t-options="{'widget': 'monetary', 'display_currency': q9_extra['currency']}"/></td></tr></tbody>
                    </table>
                    <h3>Hourly Performance</h3>
                    <table class="table table-sm">
                        <thead><tr><th>Hour</th><th class="text-end">Orders</th><th class="text-end">Qty</th><th class="text-end">Sales</th></tr></thead>
                        <tbody><tr t-foreach="q9_extra['hourly']" t-as="hour"><td t-esc="hour[0]"/><td class="text-end" t-esc="hour[1]['count']"/><td class="text-end" t-esc="hour[1]['qty']"/><td class="text-end"><span t-esc="hour[1]['total']" t-options="{'widget': 'monetary', 'display_currency': q9_extra['currency']}"/></td></tr></tbody>
                    </table>
                    <p class="fw-bold">Orders: <span t-esc="q9_extra['orders_count']"/> | Total Sales: <span t-esc="q9_extra['sales_total']" t-options="{'widget': 'monetary', 'display_currency': q9_extra['currency']}"/></p>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
