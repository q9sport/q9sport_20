<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="action_daily_cashier_pdf" model="ir.actions.report">
    <field name="name">Daily Cashier Report</field>
    <field name="model">q9.daily.cashier.wizard</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">q9_daily_cashier_report.daily_cashier_template</field>
    <field name="report_file">q9_daily_cashier_report.daily_cashier_template</field>
    <field name="print_report_name">'Daily_Cashier_%s' % (object.date_start)</field>
  </record>
  <template id="daily_cashier_template">
    <t t-call="web.html_container">
      <t t-set="data" t-value="doc._report_data()"/>
      <t t-call="web.external_layout">
        <div class="page">
          <h2>Daily Cashier Report</h2>
          <p><b>Store(s):</b> <span t-esc="', '.join(doc.config_ids.mapped('display_name')) or 'All POS'"/> |
             <b>Date:</b> <span t-esc="doc.date_start"/> - <span t-esc="doc.date_end"/></p>
          <h3>Daily Sales Report</h3>
          <table class="table table-sm">
            <thead><tr><th>Method</th><th>Qty</th><th>Total Amount</th></tr></thead>
            <tbody>
              <tr t-foreach="data['payments']" t-as="p"><td t-esc="p['method']"/><td t-esc="p['count']"/><td class="text-end"><span t-esc="p['amount']" t-options="{'widget':'monetary','display_currency':data['currency']}"/></td></tr>
              <tr class="fw-bold"><td>TOTAL SALES</td><td t-esc="data['order_count']"/><td class="text-end"><span t-esc="data['total_sales']" t-options="{'widget':'monetary','display_currency':data['currency']}"/></td></tr>
              <tr><td>COMPLIMENTARY ITEMS</td><td t-esc="data['complimentary_qty']"/><td class="text-end"><span t-esc="data['complimentary_amount']" t-options="{'widget':'monetary','display_currency':data['currency']}"/></td></tr>
            </tbody>
          </table>
          <h3>Daily Cash Collections</h3>
          <table class="table table-sm">
            <thead><tr><th>Method</th><th>Qty</th><th>Total</th></tr></thead>
            <tbody>
              <tr t-foreach="data['collections']" t-as="c"><td t-esc="c['label']"/><td t-esc="c['qty']"/><td class="text-end"><span t-esc="c['amount']" t-options="{'widget':'monetary','display_currency':data['currency']}"/></td></tr>
              <tr class="fw-bold"><td>NET TOTAL</td><td/><td class="text-end"><span t-esc="data['net_collections']" t-options="{'widget':'monetary','display_currency':data['currency']}"/></td></tr>
              <tr><td>Total Cash</td><td/><td class="text-end"><span t-esc="data['cash_total']" t-options="{'widget':'monetary','display_currency':data['currency']}"/></td></tr>
              <tr><td>Total Card / Visa</td><td/><td class="text-end"><span t-esc="data['card_total']" t-options="{'widget':'monetary','display_currency':data['currency']}"/></td></tr>
              <tr><td>Total Credit</td><td/><td class="text-end"><span t-esc="data['credit_total']" t-options="{'widget':'monetary','display_currency':data['currency']}"/></td></tr>
            </tbody>
          </table>
          <h3>Credit Accounts Report</h3>
          <table class="table table-sm">
            <thead><tr><th>Account Code</th><th>Account Name</th><th>Qty</th><th>Total Amount</th></tr></thead>
            <tbody>
              <tr t-foreach="data['credit_accounts']" t-as="a"><td t-esc="a['code']"/><td t-esc="a['name']"/><td t-esc="a['qty']"/><td class="text-end"><span t-esc="a['amount']" t-options="{'widget':'monetary','display_currency':data['currency']}"/></td></tr>
              <tr class="fw-bold"><td colspan="2">TOTAL</td><td t-esc="sum(a['qty'] for a in data['credit_accounts'])"/><td class="text-end"><span t-esc="sum(a['amount'] for a in data['credit_accounts'])" t-options="{'widget':'monetary','display_currency':data['currency']}"/></td></tr>
            </tbody>
          </table>
          <h3>Daily Items Report</h3>
          <table class="table table-sm">
            <thead><tr><th>Item Code</th><th>Item Name</th><th>Qty Sold</th><th>Total Price</th></tr></thead>
            <tbody>
              <tr t-foreach="data['products']" t-as="p"><td t-esc="p['code']"/><td t-esc="p['name']"/><td t-esc="p['qty']"/><td class="text-end"><span t-esc="p['total']" t-options="{'widget':'monetary','display_currency':data['currency']}"/></td></tr>
              <tr class="fw-bold"><td colspan="2">TOTAL</td><td t-esc="sum(p['qty'] for p in data['products'])"/><td class="text-end"><span t-esc="sum(p['total'] for p in data['products'])" t-options="{'widget':'monetary','display_currency':data['currency']}"/></td></tr>
            </tbody>
          </table>
          <h3>Daily Return Report</h3>
          <table class="table table-sm">
            <thead><tr><th>Item Code</th><th>Item Name</th><th>Qty Returned</th><th>Total Refund</th></tr></thead>
            <tbody>
              <tr t-foreach="data['returns']" t-as="r"><td t-esc="r['code']"/><td t-esc="r['name']"/><td t-esc="r['returned_qty']"/><td class="text-end"><span t-esc="r['refund']" t-options="{'widget':'monetary','display_currency':data['currency']}"/></td></tr>
              <tr class="fw-bold"><td colspan="2">TOTAL</td><td t-esc="sum(r['returned_qty'] for r in data['returns'])"/><td class="text-end"><span t-esc="sum(r['refund'] for r in data['returns'])" t-options="{'widget':'monetary','display_currency':data['currency']}"/></td></tr>
            </tbody>
          </table>
          <h3>Salesman Performance Report</h3>
          <table class="table table-sm">
            <thead><tr><th>Name</th><th>Store</th><th>Transactions</th><th>Total Sales</th><th>Avg Sale</th><th>Last Sale</th></tr></thead>
            <tbody>
              <tr t-foreach="data['cashiers']" t-as="s"><td t-esc="s['name']"/><td/><td t-esc="s['transactions']"/><td t-esc="s['sales']"/><td t-esc="s['average']"/><td t-esc="s['last_sale']"/></tr>
            </tbody>
          </table>
          <h3>Delivery Man Performance Report</h3>
          <t t-if="data['delivery_field_found']">
            <table class="table table-sm"><thead><tr><th>Name</th><th>Deliveries</th><th>Total Sales</th></tr></thead>
              <tbody><tr t-foreach="data['delivery_rows']" t-as="d"><td t-esc="d['name']"/><td t-esc="d['deliveries']"/><td t-esc="d['sales']"/></tr></tbody>
            </table>
          </t>
          <t t-else=""><p>Delivery driver field was not detected in this database. Configure a supported delivery driver field to show this section.</p></t>
          <h3>Hourly Performance Report</h3>
          <table class="table table-sm">
            <thead><tr><th>Hour</th><th>Transactions</th><th>Qty</th><th>Total Sales</th></tr></thead>
            <tbody><tr t-foreach="data['hourly']" t-as="h"><td t-esc="h[0]"/><td t-esc="h[1]['transactions']"/><td t-esc="h[1]['qty']"/><td t-esc="h[1]['sales']"/></tr></tbody>
          </table>
          <h3>Hourly Performance by POS / Channel</h3>
          <table class="table table-sm">
            <thead><tr><th>POS / Channel</th><th>Hour</th><th>Transactions</th><th>Qty</th><th>Total Sales</th></tr></thead>
            <tbody><tr t-foreach="data['config_hourly']" t-as="h"><td t-esc="h[0][0]"/><td t-esc="h[0][1]"/><td t-esc="h[1]['transactions']"/><td t-esc="h[1]['qty']"/><td t-esc="h[1]['sales']"/></tr></tbody>
          </table>
          <h3>Top Selling Items Report</h3>
          <table class="table table-sm">
            <thead><tr><th>Item Code</th><th>Item Name</th><th>Qty Sold</th><th>Revenue</th><th>Avg Price</th></tr></thead>
            <tbody><tr t-foreach="data['top_items']" t-as="t"><td t-esc="t['code']"/><td t-esc="t['name']"/><td t-esc="t['qty']"/><td t-esc="t['total']"/><td t-esc="t['total']/t['qty'] if t['qty'] else 0"/></tr></tbody>
          </table>
        </div>
      </t>
    </t>
  </template>
</odoo>
