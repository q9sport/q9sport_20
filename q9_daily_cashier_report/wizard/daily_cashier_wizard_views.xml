<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="daily_cashier_wizard_form" model="ir.ui.view">
        <field name="name">q9.daily.cashier.wizard.form</field>
        <field name="model">q9.daily.cashier.wizard</field>
        <field name="arch" type="xml">
            <form string="Daily Cashier Report">
                <group>
                    <group><field name="date_start"/><field name="date_end"/></group>
                    <group><field name="config_ids" widget="many2many_tags"/><field name="cashier_ids" widget="many2many_tags"/></group>
                </group>
                <footer>
                    <button name="action_print_pdf" string="Print PDF" type="object" class="btn-primary"/>
                    <button name="action_export_excel" string="Export Excel" type="object" class="btn-secondary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_daily_cashier_wizard" model="ir.actions.act_window">
        <field name="name">Daily Cashier Report</field>
        <field name="res_model">q9.daily.cashier.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="daily_cashier_wizard_form"/>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_daily_cashier_report" name="Daily Cashier Report"
              parent="point_of_sale.menu_point_rep" action="action_daily_cashier_wizard"
              sequence="20" groups="point_of_sale.group_pos_manager,point_of_sale.group_pos_user"/>
</odoo>
