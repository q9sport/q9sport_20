<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_product_stock_guard.ProductCard" t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <xpath expr="//article" position="inside">
            <t t-set="guardQty" t-value="this.stockGuardQty"/>
            <span t-if="guardQty !== null"
                class="o_stock_guard_badge position-absolute top-0 end-0 fw-bold"
                t-att-class="guardQty > 0 ? 'o_stock_guard_in' : 'o_stock_guard_out'"
                t-att-style="'width: 30px; height: 24px; display: flex; align-items: center; justify-content: center; font-size: 10px; border-radius: 0 0 0 12px; z-index: 5; background-color: ' + (guardQty > 5 ? '#b7e4c7' : '#f5c2c7') + '; color: ' + (guardQty > 5 ? '#245c38' : '#842029') + ';'"
                t-out="this.stockGuardQtyText"/>
            
             <!-- Product Barcode -->
            <span t-if="props.product.barcode"
                  class="position-absolute bottom-0 start-0 fw-bold text-muted"
                  style="font-size: 9px; padding: 2px 4px; background: rgba(255,255,255,0.9); z-index: 5;"
                  t-out="props.product.barcode"/>


            
<!-- <span t-if="guardQty !== null"
      class="o_stock_guard_badge position-absolute top-0 end-0 m-1 fw-bold"
      t-att-class="guardQty > 0 ? 'o_stock_guard_in' : 'o_stock_guard_out'"
      t-att-style="'width: 42px; height: 17px; line-height: 17px; padding: 0; font-size: 9px; text-align: center; border-radius: 3px; transform: none; z-index: 5; background-color: ' + (guardQty > 0 ? '#b7e4c7' : '#f5c2c7') + '; color: ' + (guardQty > 0 ? '#245c38' : '#842029') + ';'"
      t-out="this.stockGuardQtyText"/> -->



            <!-- <span t-if="guardQty !== null"
                  class="o_stock_guard_badge position-absolute top-0 start-0 m-1 px-2 rounded-pill fw-bold"
                  t-att-class="guardQty > 0 ? 'o_stock_guard_in' : 'o_stock_guard_out'"
                  t-out="this.stockGuardQtyText"/> -->
        </xpath>
    </t>
</templates>
