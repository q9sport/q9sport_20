<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_product_stock_guard.ProductCard"
       t-inherit="point_of_sale.ProductCard"
       t-inherit-mode="extension">

        <!-- STOCK QUANTITY BADGE -->

        <xpath expr="//article" position="inside">

            <t t-set="guardQty" t-value="this.stockGuardQty"/>

            <span t-if="guardQty !== null"
                  class="o_stock_guard_badge position-absolute top-0 end-0 fw-bold"
                  t-att-class="
                      guardQty &lt;= 0
                          ? 'o_stock_guard_out'
                          : guardQty &lt;= 5
                              ? 'o_stock_guard_warning'
                              : 'o_stock_guard_in'
                  "
                  t-out="this.stockGuardQtyText"/>

        </xpath>

        <!-- BARCODE AT CARD BOTTOM -->

        <xpath expr="//article" position="inside">

            <div t-if="this.stockGuardBarcode"
                 class="o_stock_guard_barcode">

                <span class="o_stock_guard_barcode_label">
                    BARCODE
                </span>

                <span class="o_stock_guard_barcode_value"
                      t-out="this.stockGuardBarcode"/>

            </div>

        </xpath>

    </t>

</templates>
