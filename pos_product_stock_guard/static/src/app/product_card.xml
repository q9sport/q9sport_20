<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_product_stock_guard.ProductCard"
       t-inherit="point_of_sale.ProductCard"
       t-inherit-mode="extension">

        <xpath expr="//article" position="inside">

            <t t-set="guardQty" t-value="this.stockGuardQty"/>

            <!-- Stock Quantity Badge -->
            <span t-if="guardQty !== null"
                  class="o_stock_guard_badge position-absolute top-0 end-0 fw-bold"
                  t-att-class="
                      guardQty <= 0
                          ? 'o_stock_guard_out'
                          : guardQty <= 5
                              ? 'o_stock_guard_warning'
                              : 'o_stock_guard_in'
                  "
                  t-att-style="
                      'width: 30px; height: 24px; display: flex; align-items: center; justify-content: center; font-size: 10px; border-radius: 0 0 0 12px; z-index: 5; background-color: ' +
                      (guardQty <= 0
                          ? '#f5c2c7'
                          : guardQty <= 5
                              ? '#fff3cd'
                              : '#b7e4c7') +
                      '; color: ' +
                      (guardQty <= 0
                          ? '#842029'
                          : guardQty <= 5
                              ? '#856404'
                              : '#245c38') +
                      ';'
                  "
                  t-out="this.stockGuardQtyText"/>

            <!-- Product Barcode -->
            <span t-if="this.stockGuardBarcode"
                  class="position-absolute bottom-0 start-50 translate-middle-x fw-bold text-center"
                  style="
                      font-size: 12px;
                      padding: 3px 8px;
                      background: rgba(173, 216, 230, 0.35);
                      color: #183153;
                      border-radius: 4px;
                      z-index: 5;
                      white-space: nowrap;
                  ">
                <span>Barcode: </span>
                <span t-out="this.stockGuardBarcode"/>
            </span>

        </xpath>
    </t>
</templates>
