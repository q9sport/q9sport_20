<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eh_shopify_stock_compare_wizard_form" model="ir.ui.view">
        <field name="name">eh.shopify.stock.compare.wizard.form</field>
        <field name="model">eh.shopify.stock.compare.wizard</field>
        <field name="arch" type="xml">
            <form string="Compare stock with Shopify">
                <p class="text-muted">
                    Shopify holds the goods at this location, so its count is the reference. Lines left ticked are
                    copied into Odoo as inventory adjustments.
                </p>
                <group>
                    <group>
                        <field name="location_binding_id"/>
                        <field name="stock_location_id"/>
                        <field name="difference_count" invisible="1"/>
                    </group>
                </group>
                <div class="alert alert-info" role="status" invisible="not note">
                    <field name="note" nolabel="1"/>
                </div>
                <field name="line_ids" nolabel="1" invisible="difference_count == 0">
                    <list editable="bottom" create="false" delete="false">
                        <field name="product_id"/>
                        <field name="odoo_quantity"/>
                        <field name="shopify_quantity"/>
                        <field name="difference"/>
                        <field name="apply"/>
                        <field name="note"/>
                    </list>
                </field>
                <footer>
                    <button name="action_apply" type="object" string="Apply ticked counts" class="btn-primary"
                            invisible="difference_count == 0" groups="stock.group_stock_manager"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
