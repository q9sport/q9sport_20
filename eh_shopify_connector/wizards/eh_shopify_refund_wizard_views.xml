<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eh_shopify_refund_wizard_form" model="ir.ui.view">
        <field name="name">eh.shopify.refund.wizard.form</field>
        <field name="model">eh.shopify.refund.wizard</field>
        <field name="arch" type="xml">
            <form string="Refund in Shopify">
                <div class="alert alert-warning" role="alert" invisible="not blocked_reason">
                    <field name="blocked_reason" nolabel="1"/>
                </div>
                <p class="text-muted">
                    Shopify refunds exactly the credit note total to the original payment methods. Nothing is refunded
                    twice, even if this is confirmed again.
                </p>
                <group>
                    <group>
                        <field name="credit_note_id"/>
                        <field name="credit_total"/>
                        <field name="shipping_amount"/>
                        <field name="currency_code"/>
                    </group>
                    <group>
                        <field name="suggested_total"/>
                        <field name="maximum_refundable"/>
                        <field name="discrepancy_reason"/>
                        <field name="notify"/>
                    </group>
                </group>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="false" delete="false">
                        <field name="name"/>
                        <field name="quantity"/>
                        <field name="restock_type"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Refund in Shopify" class="btn-primary"
                            invisible="blocked_reason"/>
                    <button name="action_preview" type="object" string="Check again" class="btn-secondary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_move_form_eh_shopify_refund" model="ir.ui.view">
        <field name="name">account.move.form.eh.shopify.refund</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="eh_shopify_can_refund" invisible="1"/>
                <button name="action_eh_shopify_refund" type="object" string="Refund in Shopify"
                        invisible="not eh_shopify_can_refund" groups="eh_shopify_connector.group_shopify_manager"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="alert" invisible="not eh_shopify_refund_note">
                    <field name="eh_shopify_refund_note" nolabel="1"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
