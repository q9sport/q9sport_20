<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eh_shopify_cancel_wizard_form" model="ir.ui.view">
        <field name="name">eh.shopify.cancel.wizard.form</field>
        <field name="model">eh.shopify.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Shopify order">
                <div class="alert alert-warning" role="alert" invisible="not blocked_reason">
                    <field name="blocked_reason" nolabel="1"/>
                </div>
                <p class="text-muted">
                    Cancelling in Shopify refunds the customer as chosen below and puts the items back on sale.
                    This order is cancelled in Odoo as soon as Shopify confirms.
                </p>
                <group>
                    <group>
                        <field name="sale_order_id"/>
                        <field name="shopify_name"/>
                        <field name="shopify_state"/>
                        <field name="refund_amount"/>
                        <field name="refund_currency" invisible="1"/>
                    </group>
                    <group>
                        <field name="reason"/>
                        <field name="refund_method"/>
                        <field name="restock"/>
                        <field name="notify_customer"/>
                    </group>
                </group>
                <group>
                    <field name="staff_note" placeholder="Not shown to the customer"/>
                </group>
                <footer>
                    <button name="action_cancel_in_shopify" type="object" string="Cancel in Shopify"
                            class="btn-primary" invisible="blocked_reason"
                            groups="eh_shopify_connector.group_shopify_manager"/>
                    <button name="action_cancel_in_odoo_only" type="object" string="Cancel in Odoo only"
                            class="btn-secondary"/>
                    <button string="Keep the order" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
