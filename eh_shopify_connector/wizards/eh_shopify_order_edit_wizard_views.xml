<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eh_shopify_order_edit_wizard_form" model="ir.ui.view">
        <field name="name">eh.shopify.order.edit.wizard.form</field>
        <field name="model">eh.shopify.order.edit.wizard</field>
        <field name="arch" type="xml">
            <form string="Send changes to Shopify">
                <div class="alert alert-warning" role="alert" invisible="not blocked_reason">
                    <field name="blocked_reason" nolabel="1"/>
                </div>
                <p class="text-muted">
                    The Shopify order is edited to hold the quantities of this Odoo order. Shopify recalculates prices,
                    taxes and the amount owed, and the order comes back into Odoo with them.
                </p>
                <field name="line_ids">
                    <list>
                        <field name="action"/>
                        <field name="name"/>
                        <field name="before"/>
                        <field name="after"/>
                        <field name="note"/>
                    </list>
                </field>
                <group>
                    <field name="sale_order_id"/>
                    <field name="notify_customer"/>
                    <field name="staff_note" placeholder="Not shown to the customer"/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Send to Shopify" class="btn-primary"
                            invisible="blocked_reason" groups="eh_shopify_connector.group_shopify_manager"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_order_form_eh_shopify_edit" model="ir.ui.view">
        <field name="name">sale.order.form.eh.shopify.edit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="eh_shopify_can_edit" invisible="1"/>
                <button name="action_eh_shopify_send_edits" type="object" string="Send changes to Shopify"
                        invisible="not eh_shopify_can_edit" groups="eh_shopify_connector.group_shopify_manager"/>
            </xpath>
        </field>
    </record>
</odoo>
