<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_eh_shopify_job_runner" model="ir.cron">
            <field name="name">Shopify: run sync jobs</field>
            <field name="model_id" ref="model_eh_shopify_job"/>
            <field name="state">code</field>
            <field name="code">model._cron_run_jobs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_eh_shopify_maintenance" model="ir.cron">
            <field name="name">Shopify: renew tokens and verify real time updates</field>
            <field name="model_id" ref="model_eh_shopify_store"/>
            <field name="state">code</field>
            <field name="code">model._cron_maintenance()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_eh_shopify_purge" model="ir.cron">
            <field name="name">Shopify: remove old finished jobs</field>
            <field name="model_id" ref="model_eh_shopify_job"/>
            <field name="state">code</field>
            <field name="code">model._cron_purge()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
