<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eh_shopify_bulk_list" model="ir.ui.view">
        <field name="name">eh.shopify.bulk.list</field>
        <field name="model">eh.shopify.bulk</field>
        <field name="arch" type="xml">
            <list string="Shopify exports" create="false" delete="false" decoration-danger="state == 'failed'"
                  decoration-muted="state == 'done'">
                <field name="store_id"/>
                <field name="kind"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"
                       decoration-danger="state == 'failed'" decoration-info="state in ('running', 'reading', 'importing')"/>
                <field name="root_object_count"/>
                <field name="chunks_enqueued" optional="show"/>
                <field name="chunks_done" optional="show"/>
                <field name="partial" optional="hide"/>
                <field name="product_gid" optional="hide"/>
                <field name="note" optional="show"/>
                <field name="started_at" optional="show"/>
                <field name="completed_at" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <button name="action_stop" type="object" string="Stop" icon="stop"
                        groups="eh_shopify_connector.group_shopify_manager"
                        invisible="state not in ('running', 'reading', 'importing')"
                        confirm="Stop this export? Products already imported stay as they are."/>
            </list>
        </field>
    </record>

    <record id="view_eh_shopify_bulk_form" model="ir.ui.view">
        <field name="name">eh.shopify.bulk.form</field>
        <field name="model">eh.shopify.bulk</field>
        <field name="arch" type="xml">
            <form string="Shopify export" create="false" edit="false" delete="false">
                <header>
                    <button name="action_stop" type="object" string="Stop" class="btn-secondary"
                            groups="eh_shopify_connector.group_shopify_manager"
                            invisible="state not in ('running', 'reading', 'importing')"
                            confirm="Stop this export? Products already imported stay as they are."/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not note">
                        <field name="note" readonly="1" nolabel="1"/>
                    </div>
                    <group>
                        <group string="What was exported">
                            <field name="store_id"/>
                            <field name="kind"/>
                            <field name="product_gid" invisible="not product_gid"/>
                            <field name="root_object_count"/>
                            <field name="object_count"/>
                            <field name="partial"/>
                        </group>
                        <group string="Progress">
                            <field name="chunks_enqueued"/>
                            <field name="chunks_done"/>
                            <field name="lines_read"/>
                            <field name="started_at"/>
                            <field name="completed_at"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Technical" groups="eh_shopify_connector.group_shopify_manager">
                        <field name="operation_gid"/>
                        <field name="status"/>
                        <field name="error_code"/>
                        <field name="file_size"/>
                        <field name="poll_count"/>
                        <field name="download_attempts"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eh_shopify_bulk" model="ir.actions.act_window">
        <field name="name">Shopify Exports</field>
        <field name="res_model">eh.shopify.bulk</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No exports yet</p>
            <p>Use Import all products on a store to bring a whole catalogue in at once.</p>
        </field>
    </record>
</odoo>
