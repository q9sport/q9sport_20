<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eh_shopify_event_list" model="ir.ui.view">
        <field name="name">eh.shopify.event.list</field>
        <field name="model">eh.shopify.event</field>
        <field name="arch" type="xml">
            <list string="Webhook deliveries" create="false" edit="false"
                  decoration-danger="state == 'failed'" decoration-muted="state == 'ignored'">
                <field name="received_at"/>
                <field name="store_id"/>
                <field name="topic"/>
                <field name="state" widget="badge" decoration-success="state == 'processed'"
                       decoration-warning="state == 'queued'" decoration-danger="state == 'failed'"/>
                <field name="resource_gid" optional="show"/>
                <field name="note" optional="show"/>
                <field name="api_version" optional="hide"/>
                <field name="webhook_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_eh_shopify_event_form" model="ir.ui.view">
        <field name="name">eh.shopify.event.form</field>
        <field name="model">eh.shopify.event</field>
        <field name="arch" type="xml">
            <form string="Webhook delivery" create="false" edit="false">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="store_id"/>
                            <field name="topic"/>
                            <field name="resource_gid"/>
                            <field name="job_id"/>
                            <field name="note"/>
                        </group>
                        <group>
                            <field name="received_at"/>
                            <field name="triggered_at"/>
                            <field name="api_version"/>
                            <field name="webhook_id"/>
                            <field name="event_id"/>
                        </group>
                    </group>
                    <label for="payload_text"/>
                    <field name="payload_text"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_eh_shopify_event_search" model="ir.ui.view">
        <field name="name">eh.shopify.event.search</field>
        <field name="model">eh.shopify.event</field>
        <field name="arch" type="xml">
            <search string="Webhook deliveries">
                <field name="topic"/>
                <field name="store_id"/>
                <field name="resource_gid"/>
                <filter name="queued" string="Queued" domain="[('state', '=', 'queued')]"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <group>
                    <filter name="group_topic" string="Topic" context="{'group_by': 'topic'}"/>
                    <filter name="group_store" string="Store" context="{'group_by': 'store_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_eh_shopify_event" model="ir.actions.act_window">
        <field name="name">Webhook Deliveries</field>
        <field name="res_model">eh.shopify.event</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_eh_shopify_event_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No webhook deliveries yet</p>
            <p>Signed deliveries from Shopify appear here once real time updates are on.</p>
        </field>
    </record>
</odoo>
