<odoo>
    <data>
        <record id="group_shopify_user" model="res.groups">
            <field name="name">Shopify User</field>
            <field name="comment">Sees Shopify stores, sync jobs and webhook deliveries, and can retry failed jobs.</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_shopify_manager" model="res.groups">
            <field name="name">Shopify Manager</field>
            <field name="comment">Connects stores, edits mappings and runs sync operations.</field>
            <field name="implied_ids" eval="[(4, ref('group_shopify_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Whoever administers this Odoo installed the connector, so the app has to be
             there for them, not only for the user the database was created with. -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_shopify_manager'))]"/>
        </record>
    </data>
</odoo>
