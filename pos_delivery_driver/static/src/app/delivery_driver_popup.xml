<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">

    <t t-name="pos_delivery_driver.DeliveryDriverPopup">

        <Dialog title="'Delivery Confirmation'" size="'lg'">

            <div class="o_delivery_driver_popup">

                <!-- Header -->
                <div class="o_delivery_popup_header">

                    <div class="o_delivery_popup_icon">
                        🚚
                    </div>

                    <div class="o_delivery_popup_header_text">

                        <span class="o_delivery_eyebrow">
                            DELIVERY SERVICE
                        </span>

                        <h2>
                            Delivery Confirmation
                        </h2>

                        <p>
                            Confirm delivery details before adding the service.
                        </p>

                    </div>

                    <span class="o_delivery_popup_tag">
                        DELIVERY
                    </span>

                </div>


                <!-- Order -->
                <div class="o_delivery_order_box">

                    <div class="o_delivery_order_icon">
                        📦
                    </div>

                    <div class="o_delivery_order_info">

                        <span>ORDER NUMBER</span>

                        <strong t-out="this.props.orderName"/>

                        <small>
                            Delivery Order
                        </small>

                    </div>

                </div>


                <!-- Driver -->
                <div t-if="!this.props.alreadyAdded"
                     class="o_delivery_driver_section">

                    <label for="o_delivery_driver_select">
                        Assign Delivery Driver
                    </label>

                    <select id="o_delivery_driver_select"
                            class="form-select"
                            t-on-change="onDriverChange">

                        <option value="">
                            No Driver Assigned
                        </option>

                        <t t-foreach="this.props.employees || []"
                           t-as="employee"
                           t-key="employee.id">

                            <option t-att-value="employee.id"
                                    t-att-selected="employee.id === this.state.selectedDriverId">

                                <t t-esc="employee.name"/>

                                <t t-if="employee.open_count">
                                    — Open:
                                    <t t-esc="employee.open_count"/>
                                </t>

                            </option>

                        </t>

                    </select>

                    <small t-if="!(this.props.employees || []).length">
                        No active drivers found. You can assign a driver later.
                    </small>

                </div>


                <!-- Payment -->
                <div t-if="!this.props.alreadyAdded"
                     class="o_delivery_payment_box">

                    <div class="o_delivery_payment_info">

                        <span class="o_delivery_eyebrow">
                            PAYMENT METHOD
                        </span>

                        <h3>
                            Payment on Delivery
                        </h3>

                        <p>
                            Customer pays when receiving the order.
                        </p>

                        <div class="o_delivery_payment_options">

                            <span t-att-class="
                                this.state.isCashOnDelivery
                                ? 'o_delivery_payment_option active'
                                : 'o_delivery_payment_option'
                            ">
                                Cash
                            </span>

                            <span t-att-class="
                                !this.state.isCashOnDelivery
                                ? 'o_delivery_payment_option active'
                                : 'o_delivery_payment_option'
                            ">
                                Card
                            </span>

                        </div>

                    </div>

                    <label class="o_delivery_toggle">

                        <input type="checkbox"
                               t-att-checked="this.state.isCashOnDelivery"
                               t-on-change="onCashOnDeliveryChange"/>

                        <span class="o_delivery_toggle_slider"/>

                    </label>

                </div>


                <!-- Duplicate -->
                <div t-if="this.props.alreadyAdded"
                     class="o_delivery_duplicate_message">

                    <strong>
                        Delivery Already Added
                    </strong>

                    <p>
                        This order already includes the delivery service.
                    </p>

                </div>


                <!-- Footer -->
                <div class="o_delivery_popup_footer">

                    <button type="button"
                            class="btn btn-secondary"
                            t-on-click="cancel">

                        Cancel

                    </button>

                    <button type="button"
                            class="o_delivery_confirm_button"
                            t-on-click="confirm">

                        <t t-if="this.props.alreadyAdded">
                            Got It
                        </t>

                        <t t-else="">
                            Confirm Delivery
                        </t>

                    </button>

                </div>

            </div>

        </Dialog>

    </t>

</templates>
