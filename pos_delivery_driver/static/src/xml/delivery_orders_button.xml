<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- =====================================================
         Q9SPORT - ROYAL SOFT GLASS NAVBAR
         ===================================================== -->

    <t t-name="pos_delivery_driver.DeliveryButtonStyles">
        <style>

            /* ===== COMMON NAVBAR BUTTONS ===== */

            .pos .pos-leftheader button {
                min-height: 40px !important;
                height: 40px !important;
                border-radius: 9px !important;
                margin: 0 3px !important;
                padding: 0 13px !important;

                background: linear-gradient(
                    145deg,
                    #f7f9fc,
                    #edf2f8
                ) !important;

                color: #344b67 !important;
                border: 1px solid #d8e0e9 !important;

                font-size: 13px !important;
                font-weight: 650 !important;

                box-shadow: 0 2px 5px rgba(40,60,85,.045) !important;
                transition: all .2s ease !important;
            }

            .pos .pos-leftheader button:hover {
                background: #e4edf7 !important;
                border-color: #b9c9db !important;
                transform: translateY(-1px);
            }

            /* ===== REGISTER ===== */

            .pos .pos-leftheader .register-button {
                background: #e8f5f5 !important;
                border-color: #a8d8d7 !important;
                color: #176b70 !important;
            }

            .pos .pos-leftheader .register-button::before {
                content: "🖥️";
                font-size: 17px;
                margin-right: 7px;
            }

            /* ===== ORDERS ===== */

            .pos .pos-leftheader .orders-button {
                background: #edf1f8 !important;
                border-color: #d0d9e6 !important;
                color: #304b6b !important;
            }

            .pos .pos-leftheader .orders-button::before {
                content: "🧾";
                font-size: 17px;
                margin-right: 7px;
            }

            /* ===== ONLINE ORDERS ===== */

            .delivery-orders-royal-btn {
                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;
                gap: 7px !important;

                height: 40px !important;
                min-height: 40px !important;
                min-width: 150px !important;

                padding: 0 13px !important;
                margin: 0 5px !important;

                border: 1px solid #c9d7e8 !important;
                border-radius: 10px !important;

                background: linear-gradient(
                    135deg,
                    #edf4fc,
                    #dce8f5
                ) !important;

                color: #304b6b !important;
                font-size: 12px !important;
                font-weight: 750 !important;

                box-shadow: 0 2px 6px rgba(40,65,95,.08) !important;
                transition: all .2s ease !important;
            }

            .delivery-orders-royal-btn:hover {
                background: #304b6b !important;
                color: white !important;
                border-color: #c6a15b !important;
            }

            .delivery-online-icon {
                width: 22px !important;
                height: 22px !important;
                flex-shrink: 0 !important;
            }

            .delivery-online-text {
                white-space: nowrap !important;
            }

            /* ===== NEW ORDER PLUS ===== */

            .pos .pos-leftheader button:has(.fa-plus),
            .pos .pos-leftheader button:has(.fa-plus-circle) {
                background: #edf7f1 !important;
                border-color: #c4e5d0 !important;
                color: #23885b !important;
                min-width: 43px !important;
                width: 43px !important;
                padding: 0 !important;
            }

            .pos .pos-leftheader button:has(.fa-plus) i,
            .pos .pos-leftheader button:has(.fa-plus-circle) i {
                color: #23885b !important;
                font-size: 20px !important;
            }

            .pos .pos-leftheader button:has(.fa-plus) svg,
            .pos .pos-leftheader button:has(.fa-plus-circle) svg {
                color: #23885b !important;
                stroke: #23885b !important;
            }

            /* ===== CURRENT ORDER ===== */

            .pos .pos-leftheader .order-button,
            .pos .pos-leftheader .order-selector button {
                background: #e8f5f5 !important;
                border: 1px solid #a8d8d7 !important;
                color: #176b70 !important;
                font-weight: 750 !important;
            }

            .pos .pos-leftheader .order-button::before,
            .pos .pos-leftheader .order-selector button::before {
                content: "🛒";
                font-size: 17px;
                margin-right: 7px;
            }

            /* ===== ONLINE ICON COLORS ===== */

            .delivery-online-icon .bag {
                fill: #dceafa;
                stroke: #315d91;
                stroke-width: 1.7;
            }

            .delivery-online-icon .globe {
                fill: #d9f1e5;
                stroke: #299b69;
                stroke-width: 1.8;
            }

            .delivery-online-icon .globe-line {
                fill: none;
                stroke: #299b69;
                stroke-width: 1.4;
            }

            /* ===== DELIVERY FOLLOW ===== */

            .delivery-follow-btn {
                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;

                width: 34px !important;
                height: 34px !important;
                min-width: 34px !important;

                padding: 0 !important;
                border-radius: 8px !important;

                background: #edf3fa !important;
                color: #31577f !important;
                border: 1px solid #d1dce9 !important;
            }

            .delivery-follow-btn:hover {
                background: #304b6b !important;
                color: #f1d49a !important;
            }

            .delivery-svg-icon {
                width: 19px !important;
                height: 19px !important;
                fill: none !important;
                stroke: currentColor !important;
                stroke-width: 1.8 !important;
                stroke-linecap: round !important;
                stroke-linejoin: round !important;
            }

            @media(max-width: 768px) {
                .delivery-orders-royal-btn {
                    min-width: 40px !important;
                    padding: 0 7px !important;
                    font-size: 11px !important;
                }

                .pos .pos-leftheader button {
                    padding: 0 7px !important;
                    font-size: 11px !important;
                }
            }

        </style>
    </t>


    <!-- =====================================================
         NAVBAR
         ===================================================== -->

    <t t-inherit="point_of_sale.Navbar"
       t-inherit-mode="extension">

        <xpath expr="." position="inside">
            <t t-call="pos_delivery_driver.DeliveryButtonStyles"/>
        </xpath>

        <xpath expr="//button[hasclass('orders-button')]"
               position="after">

            <button type="button"
                    class="btn delivery-orders-royal-btn"
                    t-on-click="() => this.onDeliveryOrdersClick()"
                    title="Online Orders"
                    aria-label="Online Orders">

                <svg class="delivery-online-icon"
                     viewBox="0 0 24 24"
                     xmlns="http://www.w3.org/2000/svg">

                    <path class="bag"
                          d="M3 8h12l1 12H2L3 8z"/>

                    <path class="bag"
                          d="M6 8V5a3 3 0 0 1 6 0v3"/>

                    <circle class="globe"
                            cx="18" cy="6" r="4"/>

                    <path class="globe-line"
                          d="M14 6h8M18 2a7 7 0 0 1 0 8M18 2a7 7 0 0 0 0 8"/>

                </svg>

                <span class="delivery-online-text">
                    Online Orders
                </span>

            </button>

        </xpath>

    </t>


    <!-- =====================================================
         TICKET SCREEN
         ===================================================== -->

    <t t-inherit="point_of_sale.TicketScreen"
       t-inherit-mode="extension">

        <xpath expr="//td[@name='delete-column']"
               position="inside">

            <button t-if="this.pos.deliveryOrdersMode"
                    type="button"
                    class="btn delivery-follow-btn"
                    title="Manage Delivery"
                    aria-label="Manage Delivery"
                    t-on-click.stop="() => this.onOpenDeliveryOrderBackend(order)">

                <svg class="delivery-svg-icon"
                     viewBox="0 0 24 24"
                     xmlns="http://www.w3.org/2000/svg">

                    <path d="M3 7h11v11H3z"/>
                    <path d="M14 11h4l3 3v4h-7z"/>
                    <circle cx="7.5" cy="19" r="2"/>
                    <circle cx="17.5" cy="19" r="2"/>

                </svg>

            </button>

        </xpath>

        <xpath expr="//div[@name='delete-column']"
               position="inside">

            <button t-if="this.pos.deliveryOrdersMode"
                    type="button"
                    class="btn delivery-follow-btn"
                    title="Manage Delivery"
                    aria-label="Manage Delivery"
                    t-on-click.stop="() => this.onOpenDeliveryOrderBackend(order)">

                <svg class="delivery-svg-icon"
                     viewBox="0 0 24 24"
                     xmlns="http://www.w3.org/2000/svg">

                    <path d="M3 7h11v11H3z"/>
                    <path d="M14 11h4l3 3v4h-7z"/>
                    <circle cx="7.5" cy="19" r="2"/>
                    <circle cx="17.5" cy="19" r="2"/>

                </svg>

            </button>

        </xpath>

    </t>

</templates>
