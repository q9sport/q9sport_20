<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- =====================================================
         Q9SPORT POS 20
         ROYAL SOFT GLASS - COMPLETE ORDER ACTIONS
         ===================================================== -->

    <t t-name="pos_delivery_driver.DeliveryButtonStyles">
        <style>

            :root {
                --q9-navy: #344f70;
                --q9-blue: #527fae;
                --q9-green: #398d68;
                --q9-teal: #287d78;
                --q9-gold: #c6a15b;
                --q9-border: #dce5ef;
            }

            /* 01 - REGISTER BUTTON */

            .pos .q9-register-btn {
                height: 40px !important;
                min-height: 40px !important;
                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;
                gap: 7px !important;
                padding: 0 13px !important;
                margin: 0 3px !important;
                border: 1px solid #b8ddd5 !important;
                border-radius: 10px !important;
                background: linear-gradient(135deg, #e9f7f3, #d9eee8) !important;
                color: #246d65 !important;
                font-size: 13px !important;
                font-weight: 700 !important;
                box-shadow: 0 2px 6px rgba(35,100,90,.06) !important;
            }

            .pos .q9-register-btn::before {
                content: "🏪" !important;
                display: inline-block !important;
                font-size: 19px !important;
                line-height: 1 !important;
            }

            .pos .q9-register-btn:hover {
                background: #d3ece4 !important;
                border-color: #8dc9bb !important;
            }

            /* 02 - ORDERS BUTTON */

            .pos .pos-leftheader button.orders-button {
                height: 40px !important;
                min-height: 40px !important;
                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;
                gap: 7px !important;
                padding: 0 13px !important;
                margin: 0 3px !important;
                border: 1px solid #d0dbea !important;
                border-radius: 10px !important;
                background: linear-gradient(135deg, #f0f4fa, #e5ecf6) !important;
                color: #344f70 !important;
                font-size: 13px !important;
                font-weight: 700 !important;
                box-shadow: 0 2px 6px rgba(45,70,100,.05) !important;
            }

            .pos .pos-leftheader button.orders-button::before {
                content: "📦" !important;
                display: inline-block !important;
                font-size: 18px !important;
                line-height: 1 !important;
            }

            .pos .pos-leftheader button.orders-button:hover {
                background: #dce8f5 !important;
                border-color: #b5c9df !important;
            }

            /* 03 - ONLINE ORDERS */

            .delivery-orders-royal-btn {
                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;
                gap: 7px !important;
                height: 40px !important;
                min-height: 40px !important;
                min-width: 155px !important;
                width: auto !important;
                padding: 0 13px !important;
                margin: 0 5px !important;
                box-sizing: border-box !important;
                flex: 0 0 auto !important;
                border: 1px solid #cbd9e9 !important;
                border-radius: 10px !important;
                background: linear-gradient(135deg, #edf5fd, #dceafa) !important;
                color: #344f70 !important;
                font-size: 12px !important;
                font-weight: 750 !important;
                box-shadow: 0 2px 7px rgba(43,69,100,.07) !important;
                cursor: pointer !important;
                transition: all .2s ease !important;
            }

            .delivery-orders-royal-btn:hover {
                background: linear-gradient(135deg, #e1edf9, #cfdef0) !important;
                border-color: #c6a15b !important;
                color: #263f5d !important;
                transform: translateY(-1px);
            }

            .delivery-orders-royal-btn .q9-online-emoji {
                display: inline-block !important;
                font-size: 18px !important;
                line-height: 1 !important;
                flex-shrink: 0 !important;
            }

            .delivery-online-text {
                display: inline-block !important;
                font-size: 12px !important;
                font-weight: 750 !important;
                white-space: nowrap !important;
                line-height: 1 !important;
            }

            .delivery-orders-royal-btn .delivery-online-icon {
                display: none !important;
            }

            /* 04 - NEW ORDER PLUS BUTTON */

            .pos button.list-plus-btn {
                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;
                width: 44px !important;
                min-width: 44px !important;
                max-width: 44px !important;
                height: 40px !important;
                min-height: 40px !important;
                max-height: 40px !important;
                padding: 0 !important;
                margin: 0 3px !important;
                box-sizing: border-box !important;
                border: 1px solid #c5e2cd !important;
                border-radius: 10px !important;
                background: linear-gradient(135deg, #eff8f1, #dcefe2) !important;
                color: #29945e !important;
                box-shadow: 0 2px 7px rgba(40,130,80,.09) !important;
                transition: all .2s ease !important;
            }

            .pos button.list-plus-btn i.oi[data-icon="add_circle"] {
                display: inline-block !important;
                font-size: 21px !important;
                line-height: 1 !important;
                color: #29945e !important;
                opacity: 1 !important;
                visibility: visible !important;
            }

            .pos button.list-plus-btn:hover {
                background: linear-gradient(135deg, #dff2e4, #cce9d5) !important;
                border-color: #85c59a !important;
                color: #237b4c !important;
                box-shadow: 0 3px 9px rgba(40,130,80,.14) !important;
                transform: translateY(-1px);
            }

            .pos button.list-plus-btn:active {
                transform: scale(.96) !important;
            }

            /* 05 - ORDER LINE CONTROLS */

            .pos .orderline button,
            .pos .orderline .control-button,
            .pos .orderline .btn {
                width: 25px !important;
                min-width: 25px !important;
                height: 25px !important;
                min-height: 25px !important;
                padding: 0 !important;
                margin: 2px !important;
                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;
                background: rgba(224,233,241,.85) !important;
                color: #36536d !important;
                border: 1px solid #d4e0e9 !important;
                border-radius: 7px !important;
                font-size: 11px !important;
                line-height: 1 !important;
                box-shadow: none !important;
            }

            .pos .orderline button:hover,
            .pos .orderline .control-button:hover {
                background: #d7e5ef !important;
                color: #183b59 !important;
            }

            .pos .orderline {
                padding: 8px 9px !important;
                margin: 4px 6px !important;
                background: rgba(239,244,248,.72) !important;
                border: 1px solid rgba(204,218,230,.8) !important;
                border-radius: 9px !important;
                box-shadow: none !important;
            }

            .pos .orderline .product-name,
            .pos .orderline .product-name span {
                font-size: 11px !important;
                line-height: 1.4 !important;
                font-weight: 600 !important;
                color: #29445d !important;
            }

            .pos .orderline .info-list {
                font-size: 9px !important;
                line-height: 1.4 !important;
                margin: 3px 0 !important;
                color: #718397 !important;
            }

            /* 06 - ORDER LINE DELETE BUTTON */

            .q9-orderline-wrapper {
                position: relative !important;
                display: flex !important;
                align-items: center !important;
                gap: 3px !important;
                width: 100% !important;
                min-width: 0 !important;
            }

            .q9-orderline-wrapper > Orderline {
                flex: 1 1 auto !important;
                min-width: 0 !important;
            }

            .q9-orderline-delete {
                display: inline-flex !important;
                flex: 0 0 29px !important;
                align-items: center !important;
                justify-content: center !important;
                width: 29px !important;
                min-width: 29px !important;
                height: 29px !important;
                min-height: 29px !important;
                padding: 0 !important;
                margin: 0 3px !important;
                border: 1px solid #f0d5d2 !important;
                border-radius: 8px !important;
                background: linear-gradient(135deg, #fff4f1, #ffe7e2) !important;
                color: #c75a50 !important;
                font-size: 15px !important;
                cursor: pointer !important;
                box-shadow: 0 2px 5px rgba(190,75,65,.07) !important;
                transition: all .2s ease !important;
            }

            .q9-orderline-delete:hover {
                background: #ffded8 !important;
                border-color: #e6aaa2 !important;
                transform: scale(1.06) !important;
            }

            /* 07 - CURRENT ORDER BUTTON */

            .pos .floating-order-container {
                display: inline-flex !important;
                align-items: center !important;
            }

            .pos .floating-order-container > button {
                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;
                gap: 7px !important;
                height: 40px !important;
                min-height: 40px !important;
                max-height: 40px !important;
                min-width: 90px !important;
                width: auto !important;
                padding: 0 12px !important;
                margin: 0 3px !important;
                box-sizing: border-box !important;
                border: 1px solid #a9d9ce !important;
                border-radius: 10px !important;
                background: linear-gradient(135deg, #e8f6f1, #d5ece4) !important;
                color: #246d65 !important;
                font-size: 14px !important;
                font-weight: 800 !important;
                box-shadow: 0 2px 7px rgba(35,100,75,.08) !important;
                transition: all .2s ease !important;
                white-space: nowrap !important;
                overflow: visible !important;
            }

            .pos .floating-order-container > button::before {
                content: "🛒" !important;
                display: inline-block !important;
                font-size: 17px !important;
                line-height: 1 !important;
                flex-shrink: 0 !important;
            }

            .pos .floating-order-container > button:hover {
                background: linear-gradient(135deg, #d9f0e7, #cce9df) !important;
                border-color: #86c7b4 !important;
                color: #1d6358 !important;
                box-shadow: 0 3px 9px rgba(35,100,75,.12) !important;
                transform: translateY(-1px);
            }

            /* 08 - CUSTOMER NAME */

            .q9-current-customer {
                display: inline-flex !important;
                align-items: center !important;
                gap: 6px !important;
                max-width: 170px !important;
                min-width: 0 !important;
                padding: 8px 10px !important;
                margin: 0 3px !important;
                border: 1px solid #c8e5db !important;
                border-radius: 9px !important;
                background: linear-gradient(135deg, #eff9f5, #e2f2ec) !important;
                color: #286e61 !important;
                font-size: 11px !important;
                font-weight: 700 !important;
                white-space: nowrap !important;
                overflow: hidden !important;
            }

            .q9-current-customer .q9-customer-name {
                overflow: hidden !important;
                text-overflow: ellipsis !important;
            }

            /* 09 - CANCEL CURRENT ORDER NEXT TO NOTES */

            .q9-cancel-current-order {
                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;
                gap: 6px !important;
                height: 38px !important;
                min-height: 38px !important;
                padding: 0 11px !important;
                margin: 0 4px !important;
                border: 1px solid #edc2bd !important;
                border-radius: 9px !important;
                background: linear-gradient(135deg, #fff1ef, #ffe2de) !important;
                color: #b94e45 !important;
                font-size: 11px !important;
                font-weight: 800 !important;
                white-space: nowrap !important;
                cursor: pointer !important;
                box-shadow: 0 2px 5px rgba(180,70,60,.07) !important;
                transition: all .2s ease !important;
                flex: 0 0 auto !important;
            }

            .q9-cancel-current-order:hover {
                background: linear-gradient(135deg, #ffe3df, #ffd4ce) !important;
                border-color: #df9c94 !important;
                color: #9e3832 !important;
                transform: translateY(-1px);
            }

            .q9-cancel-current-order:active {
                transform: scale(.96) !important;
            }

            .q9-cancel-icon {
                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;
                font-size: 15px !important;
                line-height: 1 !important;
            }

            /* 10 - SEARCH CLEAR BUTTON INSIDE SEARCH AREA */

            .pos .search-bar {
                position: relative !important;
            }

            .pos .q9-search-clear {
                position: absolute !important;
                right: 9px !important;
                top: 50% !important;
                transform: translateY(-50%) !important;

                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;

                width: 25px !important;
                min-width: 25px !important;
                height: 25px !important;
                min-height: 25px !important;

                padding: 0 !important;
                margin: 0 !important;

                border: 1px solid #efcfca !important;
                border-radius: 50% !important;

                background: linear-gradient(135deg, #fff5f2, #ffe5e0) !important;
                color: #c45b50 !important;

                font-size: 17px !important;
                font-weight: 800 !important;
                line-height: 1 !important;

                cursor: pointer !important;
                z-index: 10 !important;

                box-shadow: 0 1px 4px rgba(190,75,65,.10) !important;
            }

            .pos .q9-search-clear:hover {
                background: #f8d9d3 !important;
                border-color: #d99c95 !important;
                color: #a83d35 !important;
                transform: translateY(-50%) scale(1.08) !important;
            }

            .pos .search-bar input {
                padding-right: 39px !important;
                box-sizing: border-box !important;
            }

            /* 11 - DELIVERY FOLLOW BUTTON */

            .delivery-follow-btn {
                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;
                width: 34px !important;
                min-width: 34px !important;
                height: 34px !important;
                min-height: 34px !important;
                padding: 0 !important;
                margin: 0 auto !important;
                border: 1px solid #d1dce9 !important;
                border-radius: 9px !important;
                background: #edf3fa !important;
                color: #31577f !important;
                cursor: pointer !important;
            }

            .delivery-follow-btn:hover {
                background: #304b6b !important;
                color: #f1d49a !important;
            }

            .delivery-svg-icon {
                display: block !important;
                width: 19px !important;
                height: 19px !important;
                fill: none !important;
                stroke: currentColor !important;
                stroke-width: 1.8 !important;
                stroke-linecap: round !important;
                stroke-linejoin: round !important;
                flex-shrink: 0 !important;
            }

            /* 12 - COMMON BUTTON HOVER */

            .pos .pos-leftheader button,
            .pos .pos-rightheader button {
                transition:
                    background .2s ease,
                    border-color .2s ease,
                    box-shadow .2s ease !important;
            }

            /* 13 - RESPONSIVE */

            @media (max-width: 800px) {
                .pos .leftpane .actionpad button,
                .pos .leftpane .actionpad .button {
                    min-height: 43px !important;
                    font-size: 11px !important;
                    padding: 5px !important;
                }

                .pos .leftpane .actionpad button::before {
                    font-size: 16px !important;
                    margin-right: 4px !important;
                }
            }

            @media (max-width: 768px) {
                .delivery-orders-royal-btn {
                    min-width: 42px !important;
                    padding: 0 8px !important;
                    gap: 4px !important;
                }

                .delivery-online-text {
                    font-size: 11px !important;
                }

                .delivery-orders-royal-btn .q9-online-emoji {
                    font-size: 16px !important;
                }

                .pos .q9-register-btn,
                .pos .pos-leftheader button.orders-button {
                    padding: 0 8px !important;
                    font-size: 11px !important;
                }

                .pos button.list-plus-btn {
                    width: 44px !important;
                    min-width: 44px !important;
                    max-width: 44px !important;
                    height: 40px !important;
                    min-height: 40px !important;
                    max-height: 40px !important;
                    margin: 0 3px !important;
                }

                .pos button.list-plus-btn i.oi[data-icon="add_circle"] {
                    font-size: 21px !important;
                }

                .pos .floating-order-container > button {
                    height: 40px !important;
                    min-height: 40px !important;
                    max-height: 40px !important;
                    min-width: 90px !important;
                    padding: 0 10px !important;
                    font-size: 14px !important;
                }

                .pos .floating-order-container > button::before {
                    font-size: 17px !important;
                }

                .q9-current-customer {
                    max-width: 110px !important;
                    padding: 7px !important;
                    font-size: 10px !important;
                }

                .q9-cancel-current-order {
                    width: 35px !important;
                    min-width: 35px !important;
                    padding: 0 !important;
                    font-size: 0 !important;
                }

                .q9-cancel-current-order .q9-cancel-text {
                    display: none !important;
                }

                .pos .q9-search-clear {
                    width: 24px !important;
                    min-width: 24px !important;
                    height: 24px !important;
                    min-height: 24px !important;
                    right: 7px !important;
                }
            }

        </style>
    </t>

    <!-- =====================================================
         NAVBAR
         ===================================================== -->

    <t t-inherit="point_of_sale.Navbar"
       t-inherit-mode="extension">

        <!-- LOAD STYLES -->

        <xpath expr="." position="inside">
            <t t-call="pos_delivery_driver.DeliveryButtonStyles"/>
        </xpath>

        <!-- REGISTER BUTTON -->

        <xpath expr="//button[hasclass('orders-button')]/preceding-sibling::button[1]"
               position="attributes">

            <attribute name="class"
                       add="q9-register-btn"
                       separator=" "/>

        </xpath>

        <!-- ONLINE ORDERS -->

        <xpath expr="//button[hasclass('orders-button')]"
               position="after">

            <button
                type="button"
                class="btn delivery-orders-royal-btn"
                t-on-click="() => this.onDeliveryOrdersClick()"
                title="Online Orders"
                aria-label="Online Orders">

                <span class="q9-online-emoji">🌐</span>
                <span class="q9-online-emoji">🛍️</span>

                <span class="delivery-online-text">
                    Online Orders
                </span>

            </button>

        </xpath>

        <!-- CLEAR PRODUCT SEARCH -->

        <xpath expr="//Input" position="after">

            <button
                t-if="this.pos.searchProductWord"
                type="button"
                class="q9-search-clear"
                title="Clear product search"
                aria-label="Clear product search"
                t-on-click="() => this.onClearProductSearch()">

                ✕

            </button>

        </xpath>

        <!-- CURRENT CUSTOMER NAME -->

        <xpath expr="//CashierName" position="after">

            <div
                t-if="this.pos.getOrder()?.getPartner()"
                class="q9-current-customer"
                title="Current Customer">

                <span>👤</span>

                <span class="q9-customer-name"
                      t-out="this.pos.getOrder().getPartner().name"/>

            </div>

        </xpath>

        <!-- CANCEL CURRENT ORDER NEXT TO NOTES -->

        <xpath expr="//button[contains(@class, 'notes-button')]"
               position="after">

            <button
                t-if="this.pos.getOrder() and !this.pos.getOrder().finalized"
                type="button"
                class="q9-cancel-current-order"
                title="Cancel Current Order"
                aria-label="Cancel Current Order"
                t-on-click="() => this.onCancelCurrentOrder()">

                <span class="q9-cancel-icon">✖</span>

                <span class="q9-cancel-text">
                    Cancel Order
                </span>

            </button>

        </xpath>

    </t>

    <!-- =====================================================
         CURRENT ORDER - DELETE EACH PRODUCT LINE
         ===================================================== -->

    <t t-inherit="point_of_sale.OrderSummary"
       t-inherit-mode="extension">

        <xpath expr="//Orderline" position="replace">

            <div class="q9-orderline-wrapper">

                <Orderline
                    line="line"
                    onClick="(ev, duration) => this.clickLine(ev, line)"
                    onLongPress="(ev, duration) => this.onOrderlineLongPress(ev, line)"/>

                <button
                    type="button"
                    class="q9-orderline-delete"
                    title="Remove product"
                    aria-label="Remove product"
                    t-on-click.stop="() => this.onRemoveOrderLine(line)">

                    🗑️

                </button>

            </div>

        </xpath>

    </t>

    <!-- =====================================================
         TICKET SCREEN - DELIVERY FOLLOW BUTTON
         ===================================================== -->

    <t t-inherit="point_of_sale.TicketScreen"
       t-inherit-mode="extension">

        <!-- DESKTOP -->

        <xpath expr="//td[@name='delete-column']"
               position="inside">

            <button
                t-if="this.pos.deliveryOrdersMode"
                type="button"
                class="btn delivery-follow-btn"
                title="Manage Delivery"
                aria-label="Manage Delivery"
                t-on-click.stop="() => this.onOpenDeliveryOrderBackend(order)">

                <svg class="delivery-svg-icon"
                     viewBox="0 0 24 24"
                     xmlns="http://www.w3.org/2000/svg"
                     aria-hidden="true">

                    <path d="M3 7h11v11H3z"/>
                    <path d="M14 11h4l3 3v4h-7z"/>
                    <circle cx="7.5" cy="19" r="2"/>
                    <circle cx="17.5" cy="19" r="2"/>
                    <path d="M5 7l1-3h7l1 3"/>

                </svg>

            </button>

        </xpath>

        <!-- MOBILE -->

        <xpath expr="//div[@name='delete-column']"
               position="inside">

            <button
                t-if="this.pos.deliveryOrdersMode"
                type="button"
                class="btn delivery-follow-btn"
                title="Manage Delivery"
                aria-label="Manage Delivery"
                t-on-click.stop="() => this.onOpenDeliveryOrderBackend(order)">

                <svg class="delivery-svg-icon"
                     viewBox="0 0 24 24"
                     xmlns="http://www.w3.org/2000/svg"
                     aria-hidden="true">

                    <path d="M3 7h11v11H3z"/>
                    <path d="M14 11h4l3 3v4h-7z"/>
                    <circle cx="7.5" cy="19" r="2"/>
                    <circle cx="17.5" cy="19" r="2"/>
                    <path d="M5 7l1-3h7l1 3"/>

                </svg>

            </button>

        </xpath>

    </t>

</templates>
