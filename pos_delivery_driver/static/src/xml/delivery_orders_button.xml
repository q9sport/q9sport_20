<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- =====================================================
         DELIVERY BUTTON STYLES
    ====================================================== -->

    <t t-name="pos_delivery_driver.DeliveryButtonStyles">
        <style>
            .delivery-orders-royal-btn {
                width: 38px !important;
                min-width: 38px !important;
                height: 38px !important;
                padding: 0 !important;
                margin: 0 4px !important;

                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;

                overflow: hidden !important;
                flex-shrink: 0 !important;

                background: #304b6b !important;
                border: 1px solid #c6a15b !important;
                border-radius: 9px !important;

                color: #ffffff !important;
                box-shadow: 0 2px 5px rgba(0, 0, 0, 0.16);
                transition: all 0.2s ease-in-out;
            }

            .delivery-orders-royal-btn:hover {
                background: #243b56 !important;
                border-color: #e0bd78 !important;
                transform: translateY(-1px);
            }

            .delivery-orders-royal-btn i {
                font-size: 17px !important;
                line-height: 1 !important;
                color: #ffffff !important;
            }

            .delivery-orders-royal-btn svg {
                width: 19px !important;
                height: 19px !important;
                max-width: 19px !important;
                max-height: 19px !important;
                flex-shrink: 0 !important;
            }

            .delivery-follow-btn {
                min-width: 32px !important;
                height: 32px !important;
                padding: 4px 9px !important;

                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;
                gap: 5px !important;

                background: #304b6b !important;
                border: 1px solid #c6a15b !important;
                border-radius: 7px !important;

                color: #ffffff !important;
                font-size: 12px !important;
                font-weight: 600 !important;
                white-space: nowrap !important;
            }

            .delivery-follow-btn:hover {
                background: #243b56 !important;
                color: #ffffff !important;
            }

            .delivery-follow-btn i {
                color: #e5c47e !important;
                font-size: 13px !important;
            }
        </style>
    </t>

    <!-- =====================================================
         NAVBAR BUTTON
    ====================================================== -->

    <t t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">

        <xpath expr="//button[hasclass('orders-button')]" position="after">

            <t t-call="pos_delivery_driver.DeliveryButtonStyles"/>

            <button
                type="button"
                class="btn delivery-orders-royal-btn"
                title="Delivery Orders"
                aria-label="Delivery Orders"
                t-on-click="() => this.onDeliveryOrdersClick()">

                <i class="fa fa-truck" aria-hidden="true"/>

            </button>

        </xpath>

    </t>

    <!-- =====================================================
         TICKET SCREEN - DESKTOP FOLLOW BUTTON
    ====================================================== -->

    <t t-inherit="point_of_sale.TicketScreen" t-inherit-mode="extension">

        <xpath expr="//td[@name='delete-column']" position="before">

            <td class="text-center delivery-follow-column">

                <button
                    type="button"
                    class="btn delivery-follow-btn"
                    title="Follow Delivery Order"
                    t-on-click.stop="() => this.onOpenDeliveryOrderBackend(order)">

                    <i class="fa fa-truck" aria-hidden="true"/>
                    <span>Follow</span>

                </button>

            </td>

        </xpath>

        <!-- =================================================
             TICKET SCREEN - MOBILE FOLLOW BUTTON
        ================================================== -->

        <xpath expr="//div[@name='delete-column']" position="before">

            <div class="delivery-follow-column">

                <button
                    type="button"
                    class="btn delivery-follow-btn"
                    title="Follow Delivery Order"
                    t-on-click.stop="() => this.onOpenDeliveryOrderBackend(order)">

                    <i class="fa fa-truck" aria-hidden="true"/>
                    <span>Follow</span>

                </button>

            </div>

        </xpath>

    </t>

</templates>
