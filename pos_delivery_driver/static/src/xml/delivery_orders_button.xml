<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- =====================================================
         Q9SPORT POS 20
         ROYAL COLORFUL NAVBAR
         ===================================================== -->

    <t t-name="pos_delivery_driver.DeliveryButtonStyles">
        <style>

            /* ==============================================
               COLOR SYSTEM
               ============================================== */

            :root {
                --q9-navy: #344f70;
                --q9-blue: #527fae;
                --q9-gold: #c6a15b;
                --q9-green: #39966d;
                --q9-border: #dce4ed;
            }

            /* ==============================================
               ALL NAVBAR BUTTONS
               ============================================== */

            .pos .pos-leftheader button {
                height: 40px !important;
                min-height: 40px !important;

                border-radius: 10px !important;
                margin: 0 3px !important;
                padding: 0 13px !important;

                font-size: 13px !important;
                font-weight: 650 !important;

                border: 1px solid var(--q9-border) !important;

                box-shadow:
                    0 2px 5px rgba(40,60,85,.045) !important;

                transition:
                    background .2s ease,
                    border-color .2s ease,
                    box-shadow .2s ease !important;
            }

            /* ==============================================
               REGISTER
               ============================================== */

            .pos .pos-leftheader button.q9-register-btn {
                background: linear-gradient(
                    135deg,
                    #e8f6f3,
                    #d8eeea
                ) !important;

                color: #236e67 !important;
                border-color: #a9d9d1 !important;
            }

            .pos .pos-leftheader button.q9-register-btn::before {
                content: "🏪" !important;

                display: inline-block !important;
                font-size: 19px !important;
                line-height: 1 !important;
                margin-right: 8px !important;

                vertical-align: middle !important;
            }

            .pos .pos-leftheader button.q9-register-btn:hover {
                background: #d4eee8 !important;
                border-color: #70bcb0 !important;
            }

            /* ==============================================
               ORDERS
               ============================================== */

            .pos .pos-leftheader button.orders-button {
                background: linear-gradient(
                    135deg,
                    #f0f3fa,
                    #e4eaf4
                ) !important;

                color: #354f70 !important;
                border-color: #ccd8e7 !important;
            }

            .pos .pos-leftheader button.orders-button::before {
                content: "📦" !important;

                display: inline-block !important;
                font-size: 18px !important;
                margin-right: 8px !important;
                vertical-align: middle !important;
            }

            .pos .pos-leftheader button.orders-button:hover {
                background: #dce8f5 !important;
                border-color: #a9bfd9 !important;
            }

            /* ==============================================
               ONLINE ORDERS
               ============================================== */

            .delivery-orders-royal-btn {
                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;
                gap: 8px !important;

                height: 40px !important;
                min-height: 40px !important;

                min-width: 158px !important;
                width: auto !important;

                padding: 0 13px !important;
                margin: 0 5px !important;

                border-radius: 10px !important;
                border: 1px solid #d0ddeb !important;

                background: linear-gradient(
                    135deg,
                    #eef5fc,
                    #dfeaf7
                ) !important;

                color: #344f70 !important;

                font-size: 12px !important;
                font-weight: 750 !important;

                box-shadow:
                    0 2px 7px rgba(43,69,100,.07) !important;

                cursor: pointer !important;
                transition: all .2s ease !important;
            }

            .delivery-orders-royal-btn:hover {
                background: #dce9f7 !important;
                border-color: #c6a15b !important;
                color: #263f5d !important;
            }

            .delivery-online-icon {
                display: none !important;
            }

            .delivery-orders-royal-btn::before {
                content: "🛒" !important;
                font-size: 18px !important;
                line-height: 1 !important;
            }

            .delivery-online-text {
                display: inline-block !important;
                white-space: nowrap !important;
            }

            /* ==============================================
               NEW ORDER PLUS BUTTON
               ============================================== */

            .pos .pos-leftheader button:has(.fa-plus),
            .pos .pos-leftheader button:has(.fa-plus-circle) {
                width: 43px !important;
                min-width: 43px !important;

                padding: 0 !important;

                background: linear-gradient(
                    145deg,
                    #eff8f1,
                    #e0f1e5
                ) !important;

                border: 1px solid #c2e1ca !important;
                border-radius: 10px !important;
                color: #29945e !important;
            }

            .pos .pos-leftheader button:has(.fa-plus) i,
            .pos .pos-leftheader button:has(.fa-plus-circle) i {
                color: #29945e !important;
                font-size: 20px !important;
            }

            .pos .pos-leftheader button:has(.fa-plus) svg,
            .pos .pos-leftheader button:has(.fa-plus-circle) svg {
                color: #29945e !important;
                stroke: #29945e !important;
            }

            /* ==============================================
               CURRENT ORDER
               ============================================== */

            .pos .pos-leftheader .order-button,
            .pos .pos-leftheader .order-selector button,
            .pos .pos-leftheader button:has(.order-sequence) {

                background: linear-gradient(
                    135deg,
                    #e7f5f4,
                    #d9eeec
                ) !important;

                color: #176e70 !important;
                border: 1px solid #a9d8d4 !important;

                border-radius: 10px !important;
                font-weight: 750 !important;
            }

            .pos .pos-leftheader button:has(.order-sequence)::before,
            .pos .pos-leftheader .order-button::before {
                content: "🛍️" !important;

                font-size: 18px !important;
                margin-right: 7px !important;
            }

            /* ==============================================
               HOVER EFFECTS
               ============================================== */

            .pos .pos-leftheader button:hover {
                box-shadow:
                    0 4px 10px rgba(40,60,85,.10) !important;
            }

            /* ==============================================
               FOLLOW DELIVERY BUTTON
               ============================================== */

            .delivery-follow-btn {
                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;

                width: 34px !important;
                height: 34px !important;
                min-width: 34px !important;

                padding: 0 !important;
                margin: 0 auto !important;

                border-radius: 9px !important;

                background: #edf3fa !important;
                color: #31577f !important;

                border: 1px solid #d1dce9 !important;
                cursor: pointer !important;
            }

            .delivery-follow-btn:hover {
                background: #304b6b !important;
                color: #f1d49a !important;
            }

            .delivery-svg-icon {
                width: 19px !important;
                height: 19px !important;

                fill: none !important;
                stroke: currentColor !important;

                stroke-width: 1.8 !important;
                stroke-linecap: round !important;
                stroke-linejoin: round !important;
            }

            /* ==============================================
               RESPONSIVE
               ============================================== */

            @media(max-width: 768px) {

                .delivery-orders-royal-btn {
                    min-width: 42px !important;
                    padding: 0 8px !important;
                    font-size: 11px !important;
                }

                .pos .pos-leftheader button {
                    padding: 0 8px !important;
                    font-size: 11px !important;
                }

                .pos .pos-leftheader button.q9-register-btn::before {
                    font-size: 17px !important;
                }
            }

        </style>
    </t>


    <!-- =====================================================
         NAVBAR
         ===================================================== -->

    <t t-inherit="point_of_sale.Navbar"
       t-inherit-mode="extension">

        <xpath expr="." position="inside">
            <t t-call="pos_delivery_driver.DeliveryButtonStyles"/>
        </xpath>

        <!-- REGISTER: ADD A RELIABLE CUSTOM CLASS -->
        <xpath expr="//button[hasclass('orders-button')]/preceding-sibling::button[1]"
               position="attributes">
            <attribute name="class" add="q9-register-btn" separator=" "/>
        </xpath>

        <!-- ONLINE ORDERS -->
        <xpath expr="//button[hasclass('orders-button')]"
               position="after">

            <button
                type="button"
                class="btn delivery-orders-royal-btn"
                t-on-click="() => this.onDeliveryOrdersClick()"
                title="Online Orders"
                aria-label="Online Orders">

                <svg class="delivery-online-icon"
                     viewBox="0 0 24 24"
                     xmlns="http://www.w3.org/2000/svg">
                    <circle cx="12" cy="12" r="9"/>
                </svg>

                <span class="delivery-online-text">
                    Online Orders
                </span>

            </button>

        </xpath>

    </t>


    <!-- =====================================================
         TICKET SCREEN
         ===================================================== -->

    <t t-inherit="point_of_sale.TicketScreen"
       t-inherit-mode="extension">

        <!-- DESKTOP -->

        <xpath expr="//td[@name='delete-column']"
               position="inside">

            <button
                t-if="this.pos.deliveryOrdersMode"
                type="button"
                class="btn delivery-follow-btn"
                title="Manage Delivery"
                aria-label="Manage Delivery"
                t-on-click.stop="() => this.onOpenDeliveryOrderBackend(order)">

                <svg class="delivery-svg-icon"
                     viewBox="0 0 24 24"
                     xmlns="http://www.w3.org/2000/svg">

                    <path d="M3 7h11v11H3z"/>
                    <path d="M14 11h4l3 3v4h-7z"/>
                    <circle cx="7.5" cy="19" r="2"/>
                    <circle cx="17.5" cy="19" r="2"/>

                </svg>

            </button>

        </xpath>

        <!-- MOBILE -->

        <xpath expr="//div[@name='delete-column']"
               position="inside">

            <button
                t-if="this.pos.deliveryOrdersMode"
                type="button"
                class="btn delivery-follow-btn"
                title="Manage Delivery"
                aria-label="Manage Delivery"
                t-on-click.stop="() => this.onOpenDeliveryOrderBackend(order)">

                <svg class="delivery-svg-icon"
                     viewBox="0 0 24 24"
                     xmlns="http://www.w3.org/2000/svg">

                    <path d="M3 7h11v11H3z"/>
                    <path d="M14 11h4l3 3v4h-7z"/>
                    <circle cx="7.5" cy="19" r="2"/>
                    <circle cx="17.5" cy="19" r="2"/>

                </svg>

            </button>

        </xpath>

    </t>

</templates>
